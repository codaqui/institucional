---
// Portado de src/pages/index.tsx (HeroBanner) — MUI → HTML + Tailwind (tokens --cq-*).
---

<header
  class="bg-linear-to-br from-primary-900 to-primary-500 py-14 text-center md:py-20"
>
  <div class="mx-auto max-w-3xl px-4">
    <img
      src="/img/logo_monocromatica.svg"
      alt="Codaqui"
      class="mx-auto mb-8 h-auto w-40 md:w-50"
      width="200"
      height="64"
    />
    <p class="mx-auto mb-8 max-w-xl text-xl leading-relaxed text-white/90">
      Democratizando comunidades e projetos de tecnologia! 🇧🇷
    </p>
    <div class="flex flex-wrap justify-center gap-4">
      <a
        href="/participe/estudar"
        class="rounded-md bg-white px-6 py-3 text-lg font-bold text-primary-800 transition-colors hover:bg-neutral-100"
      >
        #QueroEstudar
      </a>
      <a
        href="/participe/apoiar"
        class="rounded-md border border-white/50 px-6 py-3 text-lg font-bold text-white transition-colors hover:border-white hover:bg-white/10"
      >
        #QueroApoiar
      </a>
    </div>
  </div>
</header>
