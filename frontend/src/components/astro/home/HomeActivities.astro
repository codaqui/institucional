---
import type { HomeActivity } from "../../../lib/home-journeys";

interface Props {
  activities: HomeActivity[];
}

const { activities } = Astro.props;
const dateFormatter = new Intl.DateTimeFormat("pt-BR", {
  dateStyle: "medium",
  timeZone: "America/Sao_Paulo",
});
---

<section class="mx-auto max-w-6xl px-4 py-12 md:py-16" aria-labelledby="home-activities-title">
  <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
    <h2 id="home-activities-title" class="text-3xl font-extrabold">O que as comunidades estão fazendo</h2>
    <a href="/eventos" class="font-bold text-link">Agenda de todas →</a>
  </div>
  {activities.length > 0 ? (
    <div class="grid gap-5 md:grid-cols-3">
      {activities.map((activity) => (
        <article class="overflow-hidden rounded-xl border border-border bg-surface shadow-sm">
          {activity.imageUrl ? (
            <img src={activity.imageUrl} alt="" width="640" height="240" loading="lazy" class="aspect-[8/3] w-full object-cover" />
          ) : (
            <div class="flex aspect-[8/3] items-center justify-center bg-sunken px-5 text-center text-lg font-extrabold text-link" aria-hidden="true">
              {activity.title}
            </div>
          )}
          <div class="p-5">
            <p class="text-sm font-bold text-link">Atividade da comunidade</p>
            <h3 class="mt-1 text-xl font-extrabold">
              <a href={activity.href} class="text-text-primary no-underline hover:text-link">{activity.title}</a>
            </h3>
            <p class="mt-2 text-sm text-text-secondary">
              {dateFormatter.format(new Date(activity.startAt))} · {activity.location}
            </p>
            <p class="mt-3 text-sm leading-relaxed text-text-secondary">{activity.summary}</p>
          </div>
        </article>
      ))}
    </div>
  ) : (
    <div class="rounded-xl border border-border bg-surface p-6 text-center">
      <p class="text-text-secondary">Nenhuma atividade futura está publicada neste momento.</p>
      <a href="/eventos" class="mt-3 inline-block font-bold text-link">Consultar a agenda e o histórico →</a>
    </div>
  )}
</section>
