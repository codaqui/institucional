---
// Portado de src/components/StatCard/index.tsx (MUI → HTML + Tailwind, tokens --cq-*).
// Ícone via slot nomeado "icon" (no original era React.ReactNode).

interface Props {
  value: string | number;
  label: string;
  /** Classe de cor do valor/ícone — padrão text-link (equivalente AA ao primary.main do original) */
  colorClass?: string;
  /** "outlined" = card com borda e hover shadow; "filled" = fundo sunken sem borda */
  variant?: "outlined" | "filled";
}

const { value, label, colorClass = "text-link", variant = "outlined" } = Astro.props;
---

{
  variant === "filled" ? (
    <div class="rounded-2xl bg-sunken px-2 py-5 text-center">
      {Astro.slots.has("icon") && (
        <div class:list={["mb-1", colorClass]}>
          <slot name="icon" />
        </div>
      )}
      <h5
        class:list={[
          "truncate text-[1.1rem] font-extrabold sm:text-xl md:text-[1.4rem]",
          colorClass,
        ]}
      >
        {value}
      </h5>
      <p class="text-xs text-text-secondary">{label}</p>
    </div>
  ) : (
    <div class="rounded-lg border border-border bg-surface p-4 text-center transition-shadow hover:shadow-md md:p-6">
      {Astro.slots.has("icon") && (
        <div class:list={["mb-2", colorClass]}>
          <slot name="icon" />
        </div>
      )}
      <h4
        class:list={[
          "truncate text-xl leading-[1.2] font-extrabold sm:text-2xl md:text-[1.75rem] lg:text-[2rem]",
          colorClass,
        ]}
      >
        {value}
      </h4>
      <p class="mt-1 text-sm text-text-secondary">{label}</p>
    </div>
  )
}
