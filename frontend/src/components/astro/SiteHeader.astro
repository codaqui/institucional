---
import BrandLogo from "./BrandLogo.astro";
import NavbarAuth from "../islands/NavbarAuth";
import ThemeToggle from "../islands/ThemeToggle";
import {
  INTEGRATE_COMMUNITY_LINK,
  SITE_NAVIGATION,
  isNavigationCurrent,
  isNavigationItemCurrent,
} from "../../lib/site-navigation";

const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-40 border-b border-border bg-surface">
  <nav class="mx-auto flex h-16 max-w-6xl items-center gap-4 px-4" aria-label="Navegação principal">
    <a href="/" class="flex items-center gap-2 font-extrabold text-text-primary">
      <BrandLogo class="h-8 w-auto" />
    </a>
    {/* Nav inline em telas largas; abaixo disso o drawer leva os mesmos links. */}
    <div class="cq-header-nav hidden items-center gap-3 xl:flex">
      {SITE_NAVIGATION.map((item) => {
        const current = isNavigationItemCurrent(pathname, item);
        if (item.kind === "link") {
          return (
            <a
              href={item.href}
              aria-current={current ? "page" : undefined}
              class:list={[
                "border-b-2 py-2 text-sm font-bold whitespace-nowrap hover:text-link",
                current
                  ? "border-link text-link"
                  : "border-transparent text-text-primary",
              ]}
            >
              {item.label}
            </a>
          );
        }
        const groupId = `cq-nav-${item.label.toLowerCase()}`;
        return (
          <div>
            <button
              type="button"
              popovertarget={groupId}
              aria-expanded="false"
              aria-controls={groupId}
              class:list={[
                "flex items-center gap-1 border-b-2 py-2 text-sm font-bold whitespace-nowrap hover:text-link",
                current
                  ? "border-link text-link"
                  : "border-transparent text-text-primary",
              ]}
            >
              {item.label}<span aria-hidden="true">▾</span>
            </button>
            <ul id={groupId} data-nav-popover popover="auto" class="cq-nav-popover m-0 w-56 list-none border border-border bg-surface p-2 shadow-md">
              {item.links.map((link) => {
                const childCurrent = isNavigationCurrent(pathname, link.href);
                return (
                  <li>
                    <a
                      href={link.href}
                      aria-current={childCurrent ? "page" : undefined}
                      class:list={[
                        "block rounded-md px-3 py-2 text-sm no-underline hover:bg-sunken",
                        childCurrent ? "bg-sunken font-bold text-link" : "text-text-primary",
                      ]}
                    >
                      {link.label}
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        );
      })}
      <a
        href={INTEGRATE_COMMUNITY_LINK.href}
        aria-current={isNavigationCurrent(pathname, INTEGRATE_COMMUNITY_LINK.href) ? "page" : undefined}
        class="rounded-md bg-action px-3 py-2 text-sm font-bold whitespace-nowrap text-on-action hover:opacity-90"
      >
        {INTEGRATE_COMMUNITY_LINK.label}
      </a>
      <a href="/busca" aria-label="Buscar" class="rounded-md p-2 text-text-primary hover:bg-sunken hover:text-link">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-5 w-5">
          <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
        </svg>
      </a>
    </div>
    <span class="ms-auto flex items-center gap-1">
      <span class="hidden items-center gap-1 xl:inline-flex">
        <ThemeToggle client:load />
        <NavbarAuth client:load />
      </span>
      <button
        type="button"
        id="cq-menu-trigger"
        class="inline-flex items-center justify-center rounded-md p-2 text-text-primary hover:bg-sunken xl:hidden"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="cq-site-drawer"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-6 w-6">
          <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
        </svg>
      </button>
    </span>
  </nav>
</header>

{/* Drawer mobile — guia navigation-drawer: popover="manual" no top layer,
    backdrop escurecido, ESC/backdrop/fechar dispensam, foco entra no painel
    e fica preso nele (helpers testados em src/lib/header-menu.ts). */}
<div id="cq-site-drawer" class="cq-drawer xl:hidden" popover="manual">
  <div class="cq-drawer-panel" tabindex="-1">
    <div class="flex items-center justify-between border-b border-border px-4 py-3">
      <a href="/" class="flex items-center gap-2 font-extrabold text-text-primary">
        <BrandLogo class="h-8 w-auto" />
      </a>
      <button
        type="button"
        id="cq-menu-close"
        class="inline-flex items-center justify-center rounded-md p-2 text-text-primary hover:bg-sunken"
        aria-label="Fechar menu"
      >
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-6 w-6">
          <path d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
        </svg>
      </button>
    </div>
    <nav class="flex-1 overflow-y-auto px-4 py-3" aria-label="Navegação do menu">
      <ul class="m-0 flex list-none flex-col gap-1 p-0">
        {[{ label: "Início", href: "/" }, { label: "Buscar", href: "/busca" }].map((link) => {
          const current = isNavigationCurrent(pathname, link.href);
          return (
            <li>
              <a
                href={link.href}
                aria-current={current ? "page" : undefined}
                class:list={[
                  "block rounded-md border-l-4 px-3 py-2 text-base font-bold no-underline hover:bg-sunken",
                  current
                    ? "border-link bg-sunken text-link"
                    : "border-transparent text-text-primary",
                ]}
              >
                {link.label}
              </a>
            </li>
          );
        })}
        {SITE_NAVIGATION.map((item) => {
          if (item.kind === "link") {
            const current = isNavigationCurrent(pathname, item.href);
            return (
              <li>
                <a
                  href={item.href}
                  aria-current={current ? "page" : undefined}
                  class:list={[
                    "block rounded-md border-l-4 px-3 py-2 text-base font-bold no-underline hover:bg-sunken",
                    current
                      ? "border-link bg-sunken text-link"
                      : "border-transparent text-text-primary",
                  ]}
                >
                  {item.label}
                </a>
              </li>
            );
          }
          const groupId = `cq-mobile-nav-${item.label.toLowerCase()}`;
          const current = isNavigationItemCurrent(pathname, item);
          return (
            <li>
              <button
                type="button"
                data-nav-disclosure
                aria-expanded="false"
                aria-controls={groupId}
                class:list={[
                  "flex w-full items-center justify-between rounded-md border-l-4 px-3 py-2 text-left text-base font-bold hover:bg-sunken",
                  current
                    ? "border-link bg-sunken text-link"
                    : "border-transparent text-text-primary",
                ]}
              >
                {item.label}<span aria-hidden="true">▾</span>
              </button>
              <ul id={groupId} data-nav-disclosure-panel class="m-0 list-none p-0 pb-1 ps-4">
                {item.links.map((link) => {
                  const childCurrent = isNavigationCurrent(pathname, link.href);
                  return (
                    <li>
                      <a
                        href={link.href}
                        aria-current={childCurrent ? "page" : undefined}
                        class:list={[
                          "block rounded-md px-3 py-2 text-sm no-underline hover:bg-sunken",
                          childCurrent ? "bg-sunken font-bold text-link" : "text-text-primary",
                        ]}
                      >
                        {link.label}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </li>
          );
        })}
        <li class="mt-3 border-t border-border pt-3">
          <a
            href={INTEGRATE_COMMUNITY_LINK.href}
            class="block rounded-md bg-action px-3 py-2 text-center text-base font-bold text-on-action no-underline"
          >
            {INTEGRATE_COMMUNITY_LINK.label}
          </a>
        </li>
      </ul>
    </nav>
    <div class="flex items-center justify-between gap-2 border-t border-border px-4 py-3">
      <ThemeToggle client:load />
      <NavbarAuth client:load variant="inline" />
    </div>
  </div>
</div>

<style>
  .cq-nav-popover {
    position: fixed;
    inset: auto;
    max-height: calc(100dvh - 5rem);
    overflow-y: auto;
    border-radius: var(--cq-radius-md);
  }

  .cq-drawer {
    /* Reset do UA popover + viewport inteiro: o backdrop cobre a página e
       cliques fora do painel caem no próprio popover (light dismiss). */
    inset: 0;
    width: auto;
    height: auto;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    overflow: visible;
  }
  .cq-drawer::backdrop {
    background: rgb(0 0 0 / 0.45);
  }
  .cq-drawer-panel {
    width: min(20em, 85dvw);
    height: 100dvh;
    display: flex;
    flex-direction: column;
    background: var(--cq-bg-surface);
    border-right: 1px solid var(--cq-border-default);
    transform: translateX(-100%);
    transition:
      transform var(--cq-motion-normal) var(--cq-motion-ease),
      display var(--cq-motion-normal) allow-discrete;
  }
  .cq-drawer:popover-open .cq-drawer-panel {
    transform: translateX(0);
  }
  @starting-style {
    .cq-drawer:popover-open .cq-drawer-panel {
      transform: translateX(-100%);
    }
  }
</style>

<script>
  import {
    isOutside,
    focusableIn,
    nextTrapTarget,
    toggleDisclosure,
  } from "../../lib/header-menu";

  document.querySelectorAll<HTMLElement>("[data-nav-popover]").forEach((panel) => {
    const trigger = document.querySelector<HTMLButtonElement>(`[popovertarget="${panel.id}"]`);
    panel.addEventListener("toggle", () => {
      const open = panel.matches(":popover-open");
      trigger?.setAttribute("aria-expanded", String(open));
      if (!open || !trigger) return;
      const rect = trigger.getBoundingClientRect();
      panel.style.top = `${rect.bottom + 8}px`;
      const width = panel.offsetWidth;
      panel.style.left = `${Math.max(16, Math.min(rect.left, window.innerWidth - width - 16))}px`;
    });
  });

  document.querySelectorAll<HTMLButtonElement>("[data-nav-disclosure]").forEach((trigger) => {
    const panel = document.getElementById(trigger.getAttribute("aria-controls") ?? "");
    if (!panel) return;
    trigger.setAttribute("aria-expanded", "false");
    panel.hidden = true;
    trigger.addEventListener("click", () => toggleDisclosure(trigger, panel));
  });

  // Drawer mobile.
  const drawer = document.getElementById("cq-site-drawer");
  const trigger = document.getElementById("cq-menu-trigger");
  const panel = drawer?.querySelector<HTMLElement>(".cq-drawer-panel");
  const main = document.querySelector<HTMLElement>("main");

  if (drawer instanceof HTMLElement && trigger instanceof HTMLButtonElement && panel) {
    let lastFocused: HTMLElement | null = null;

    const openDrawer = () => {
      lastFocused = document.activeElement as HTMLElement | null;
      drawer.showPopover();
      main?.setAttribute("inert", "");
      trigger.setAttribute("aria-expanded", "true");
      panel.focus();
    };

    const closeDrawer = () => {
      if (!drawer.matches(":popover-open")) return;
      drawer.hidePopover();
      main?.removeAttribute("inert");
      trigger.setAttribute("aria-expanded", "false");
      lastFocused?.focus();
    };

    trigger.addEventListener("click", () => {
      if (drawer.matches(":popover-open")) closeDrawer();
      else openDrawer();
    });

    drawer.querySelector("#cq-menu-close")?.addEventListener("click", closeDrawer);

    // Backdrop: clique no popover fora do painel dispensam (guia).
    drawer.addEventListener("click", (event) => {
      if (isOutside(event.target, panel)) closeDrawer();
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeDrawer();
    });

    // Focus trap: nas bordas do painel o Tab enrola (helpers testados).
    panel.addEventListener("keydown", (event) => {
      if (event.key !== "Tab") return;
      const next = nextTrapTarget(focusableIn(panel), document.activeElement, event.shiftKey);
      if (next) {
        event.preventDefault();
        next.focus();
      }
    });
  }
</script>
