---
// Banner em gradiente das páginas de blog de comunidade (post, etiquetas,
// autores) — port 1:1 do swizzle src/theme/BlogLayout/index.tsx do
// Docusaurus: linear-gradient(135deg, theme.primary → theme.primaryDark),
// logo, "Blog da {shortName}" e chip "← Voltar à home".
import type { CommunitySiteConfig } from "../../../../../comunidades/shared/types";

interface Props {
  config: CommunitySiteConfig;
  /** href do chip "Voltar à home": "/" no build tenant, basePath no codaqui. */
  homeHref: string;
}

const { config, homeHref } = Astro.props;
---

<div
  class="mb-8 flex flex-col gap-4 rounded-2xl p-4 text-white sm:flex-row sm:items-center sm:justify-between md:p-6"
  style="background: linear-gradient(135deg, var(--community-primary) 0%, var(--community-primary-dark) 100%)"
>
  <div class="flex items-center gap-3">
    <img
      src={config.logoUrl}
      alt={config.name}
      class="h-14 w-14 rounded-lg bg-white/95 p-1"
    />
    <div>
      <p class="m-0 text-xl font-extrabold">Blog da {config.shortName}</p>
      <p class="m-0 text-sm opacity-90">
        Histórias, ações e prestações de contas da comunidade.
      </p>
    </div>
  </div>
  <a
    href={homeHref}
    class="inline-flex w-fit items-center gap-1 rounded-full bg-white/15 px-3 py-1.5 text-sm font-semibold text-white no-underline transition-colors hover:bg-white/25"
  >
    ← Voltar à home
  </a>
</div>
