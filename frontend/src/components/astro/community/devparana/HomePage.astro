---
// Página "Home" do DevParaná — port 1:1 de
// comunidades/devparana/src/pages/index.tsx (spec): hero visual
// (heroVisual → CommunityHero), "Próximos eventos" (snapshot filtrado por
// `eventSources`, mesmo filtro do original), explore e canais. Compartilhada
// entre o build tenant (rotas limpas, home é "/") e o portal codaqui
// (/comunidades/devparana) — só muda o homeHref.
//
// Em builds tenant os links derivados do config têm o prefixo
// `/comunidades/<slug>` removido; os links que apontam para o portal Codaqui
// (agenda e detalhes de eventos, e o card "Eventos" do explore — rota do
// portal não prefixada) usam a origem absoluta via resolveCodaquiUrl; o
// dist/_redirects cobre os paths absolutos que ficam nos configs (ex.:
// navMenu, CTAs do hero).
import CommunityLayout from "../CommunityLayout.astro";
import CommunityHero from "../CommunityHero.astro";
import CommunityExploreSection from "../CommunityExploreSection.astro";
import CommunityChannelsSection from "../CommunityChannelsSection.astro";
import HomeEventsSection from "./HomeEventsSection.astro";
import {
  devparanaFeatureCards,
  tenantExploreCardHref,
  upcomingCommunityEvents,
} from "../../../../lib/community-devparana";
import { loadEventsIndex } from "../../../../lib/events";
import { resolveCodaquiUrl } from "../../../../lib/api-url";
import { getTenant } from "../../../../lib/tenant";

import type { CommunitySiteConfig } from "../../../../../../comunidades/shared/types";

interface Props {
  config: CommunitySiteConfig;
  site: string;
  /** "/" no build tenant, communityBasePath(config) no portal codaqui. */
  homeHref: string;
}

const { config, site, homeHref } = Astro.props;

const tenantBuild = getTenant() !== null;

// Origem absoluta do portal Codaqui (build tenant): rotas do portal que não
// são prefixadas com o basePath da comunidade (ex.: o card "Eventos",
// `/eventos`) precisam do host absoluto — o `_redirects` só cobre
// `/comunidades/<slug>[/*]`.
const portal = tenantBuild ? resolveCodaquiUrl("https://codaqui.dev", "") : "";

// Rotas limpas no build tenant: remove o basePath do portal dos cards e
// aponta rotas do portal (card Eventos) para a origem absoluta da Codaqui.
const exploreCards = devparanaFeatureCards(config).map((card) => ({
  ...card,
  to: tenantExploreCardHref(card.to, config.basePath, portal),
}));

// Próximos eventos: build time (snapshot do monorepo), mesmo filtro do
// original (sourceKeys + status !== "completed", ASC, top 3). Snapshot
// ausente → alerta de aviso (estado de erro do original), build continua.
const sourceKeys = config.eventSources ?? [];
let upcoming: ReturnType<typeof upcomingCommunityEvents> = [];
let eventsError = false;
try {
  upcoming = upcomingCommunityEvents(loadEventsIndex().events, sourceKeys);
} catch (error) {
  eventsError = true;
  console.warn(
    "[devparana] Snapshot de eventos indisponível — seção renderiza o estado de erro.",
    error,
  );
}
const eventsHref =
  sourceKeys.length > 0
    ? `${portal}/eventos?source=${encodeURIComponent(sourceKeys[0])}`
    : `${portal}/eventos`;
---

<CommunityLayout
  config={config}
  site={site}
  title={`${config.shortName} — Comunidade parceira`}
  homeHref={homeHref}
>
  <CommunityHero config={config} />

  {
    eventsError ? (
      <section class="border-t border-border py-10 md:py-16">
        <div class="mx-auto max-w-6xl px-4">
          <h2 class="m-0 mb-4 text-3xl font-bold">Próximos eventos</h2>
          <div class="cq-events-error rounded-lg border p-4 text-sm">
            Não foi possível carregar a agenda de eventos no momento. Tente
            novamente mais tarde.
          </div>
        </div>
      </section>
    ) : (
      <HomeEventsSection
        events={upcoming}
        eventsHref={eventsHref}
        portalPrefix={portal}
      />
    )
  }

  <CommunityExploreSection config={config} cards={exploreCards} />
  <CommunityChannelsSection config={config} />
</CommunityLayout>

<style>
  .cq-events-error {
    border-color: var(--cq-color-warning);
    color: var(--cq-text-secondary);
  }
</style>
