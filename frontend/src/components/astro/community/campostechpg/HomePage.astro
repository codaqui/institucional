---
// Página "Home" da CamposTech — port 1:1 de
// comunidades/campostechpg/src/pages/index.tsx (spec). A CamposTech NÃO é
// tenant (sem build de domínio próprio) — o componente é usado pelos wrappers
// codaqui em `/comunidades/campostechpg`; o config é importado direto de
// `comunidades/campostechpg/community.config` (em vez de `loadTenantConfig`,
// que só conhece os tenants) e o homeHref é o basePath da comunidade.
//
// Seções (mesma ordem do original): hero (chip + CTAs + logo), "Como podemos
// ajudar?" (3 pilares), "Próximos eventos" (build time, fonte sympla:campostech),
// CommunityImpactSection, CommunityExploreSection (cards via
// `campostechFeatureCards`) e CommunityChannelsSection.
import CommunityLayout from "../CommunityLayout.astro";
import CommunityImpactSection from "../CommunityImpactSection.astro";
import CommunityExploreSection from "../CommunityExploreSection.astro";
import CommunityChannelsSection from "../CommunityChannelsSection.astro";
import HomeEventsSection from "./HomeEventsSection.astro";
import {
  campostechFeatureCards,
  upcomingCommunityEvents,
} from "../../../../lib/community-campostechpg";
import { loadEventsIndex } from "../../../../lib/events";

import type { CommunitySiteConfig } from "../../../../../../comunidades/shared/types";

interface Props {
  config: CommunitySiteConfig;
  site: string;
  /** communityBasePath(config) no portal codaqui. */
  homeHref: string;
}

const { config, site, homeHref } = Astro.props;

// Cards de "Explore a comunidade" — 1:1 com buildFeatureCards() do index.tsx.
const exploreCards = campostechFeatureCards(config);

// Próximos eventos: build time (snapshot do monorepo), mesmo filtro do
// original (sourceKeys + status !== "completed", ASC, top 3). Snapshot
// ausente → alerta de aviso (estado de erro do original), build continua.
const sourceKeys = config.eventSources ?? [];
let upcoming: ReturnType<typeof upcomingCommunityEvents> = [];
let eventsError = false;
try {
  upcoming = upcomingCommunityEvents(loadEventsIndex().events, sourceKeys);
} catch (error) {
  eventsError = true;
  console.warn(
    "[campostechpg] Snapshot de eventos indisponível — seção renderiza o estado de erro.",
    error,
  );
}
const eventsHref =
  sourceKeys.length > 0
    ? `/eventos?source=${encodeURIComponent(sourceKeys[0])}`
    : "/eventos";

// "Como podemos ajudar?" — mesmos 3 pilares do index.tsx (título e descrição).
// Ícones hub/school/campaign do @mui/icons-material (fill currentColor).
const pilares = [
  {
    title: "Networking",
    description:
      "Conectamos você a profissionais experientes e instituições de apoio para que você possa desenvolver sua carreira ou seu negócio.",
    iconPath:
      "M8.4 18.2c.38.5.6 1.12.6 1.8 0 1.66-1.34 3-3 3s-3-1.34-3-3 1.34-3 3-3c.44 0 .85.09 1.23.26l1.41-1.77c-.92-1.03-1.29-2.39-1.09-3.69l-2.03-.68c-.54.83-1.46 1.38-2.52 1.38-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3c0 .07 0 .14-.01.21l2.03.68c.64-1.21 1.82-2.09 3.22-2.32V5.91C9.96 5.57 9 4.4 9 3c0-1.66 1.34-3 3-3s3 1.34 3 3c0 1.4-.96 2.57-2.25 2.91v2.16c1.4.23 2.58 1.11 3.22 2.32L18 9.71V9.5c0-1.66 1.34-3 3-3s3 1.34 3 3-1.34 3-3 3c-1.06 0-1.98-.55-2.52-1.37l-2.03.68c.2 1.29-.16 2.65-1.09 3.69l1.41 1.77Q17.34 17 18 17c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3c0-.68.22-1.3.6-1.8l-1.41-1.77c-1.35.75-3.01.76-4.37 0z",
  },
  {
    title: "Conhecimento",
    description:
      "Nossa comunidade produz muito conteúdo sobre tecnologia, desenvolvimento, testes, gestão de projetos, ux design, entre outros temas relevantes.",
    iconPath:
      "M5 13.18v4L12 21l7-3.82v-4L12 17zM12 3 1 9l11 6 9-4.91V17h2V9z",
  },
  {
    title: "Divulgação",
    description:
      "Nosso site, canais de comunicação e mídias sociais estarão sempre abertos para divulgar seus projetos, iniciativas e novidades.",
    iconPath:
      "M18 11v2h4v-2zm-2 6.61c.96.71 2.21 1.65 3.2 2.39.4-.53.8-1.07 1.2-1.6-.99-.74-2.24-1.68-3.2-2.4-.4.54-.8 1.08-1.2 1.61M20.4 5.6c-.4-.53-.8-1.07-1.2-1.6-.99.74-2.24 1.68-3.2 2.4.4.53.8 1.07 1.2 1.6.96-.72 2.21-1.65 3.2-2.4M4 9c-1.1 0-2 .9-2 2v2c0 1.1.9 2 2 2h1v4h2v-4h1l5 3V6L8 9zm11.5 3c0-1.33-.58-2.53-1.5-3.35v6.69c.92-.81 1.5-2.01 1.5-3.34",
  },
];

// Ícones volunteer_activism/open_in_new do @mui/icons-material (hero CTAs).
const VOLUNTEER_ACTIVISM_PATH =
  "M1 11h4v11H1zm15-7.75C16.65 2.49 17.66 2 18.7 2 20.55 2 22 3.45 22 5.3c0 2.27-2.91 4.9-6 7.7-3.09-2.81-6-5.44-6-7.7C10 3.45 11.45 2 13.3 2c1.04 0 2.05.49 2.7 1.25M20 17h-7l-2.09-.73.33-.94L13 16h2.82c.65 0 1.18-.53 1.18-1.18 0-.49-.31-.93-.77-1.11L8.97 11H7v9.02L14 22l8.01-3c-.01-1.1-.9-2-2.01-2";
const OPEN_IN_NEW_PATH =
  "M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3z";
---

<CommunityLayout
  config={config}
  site={site}
  title={`${config.shortName} — Comunidade parceira`}
  homeHref={homeHref}
>
  <section class="cq-hero text-white">
    <div class="mx-auto max-w-6xl px-4 py-12 md:py-20">
      <div class="grid items-center gap-8 md:grid-cols-[7fr_5fr]">
        <div class="space-y-6">
          <span
            class="inline-block w-fit rounded-full bg-white/15 px-3 py-1.5 text-sm font-semibold"
          >
            Comunidade parceira da Codaqui
          </span>
          <h1 class="m-0 text-3xl font-extrabold md:text-5xl">
            Olá, nós somos <span class="cq-highlight">{config.shortName}</span>
          </h1>
          <p class="m-0 text-xl font-normal opacity-95">{config.tagline}</p>
          <p class="m-0 opacity-90">{config.description}</p>
          <div class="flex flex-col gap-4 pt-2 sm:flex-row">
            <a
              href={config.hero.ctaPrimary.to}
              class="cq-cta-primary inline-flex items-center justify-center gap-2 rounded-md px-5 py-2.5 text-sm font-bold no-underline"
            >
              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                class="h-5 w-5"
              >
                <path d={VOLUNTEER_ACTIVISM_PATH}></path>
              </svg>
              {config.hero.ctaPrimary.label}
            </a>
            {
              config.hero.ctaSecondary && (
                <a
                  href={config.hero.ctaSecondary.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 rounded-md border border-white/60 px-5 py-2.5 text-sm font-bold text-white no-underline transition-colors hover:border-white hover:bg-white/5"
                >
                  {config.hero.ctaSecondary.label}
                  <svg
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                    class="h-4 w-4"
                  >
                    <path d={OPEN_IN_NEW_PATH}></path>
                  </svg>
                </a>
              )
            }
          </div>
        </div>
        <div class="text-center">
          <div class="mx-auto w-45 md:w-65">
            <img
              src={config.logoUrl}
              alt={`Logo ${config.shortName}`}
              class="block h-auto w-full"
            />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="pilares" class="mx-auto max-w-6xl px-4 py-10 md:py-16">
    <h2 class="m-0 mb-4 text-3xl font-bold">
      Como podemos <span style="color: var(--community-primary)">ajudar?</span>
    </h2>
    <p class="m-0 mb-8 text-text-secondary">
      Os três pilares que sustentam o nosso trabalho na região dos Campos
      Gerais.
    </p>
    <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3">
      {
        pilares.map((pilar) => (
          <div class="h-full rounded-lg border border-border bg-surface p-6 text-center">
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              class="mx-auto mb-4 h-8 w-8"
              style="color: var(--community-primary)"
            >
              <path d={pilar.iconPath} />
            </svg>
            <h3 class="m-0 mb-2 text-xl font-bold">{pilar.title}</h3>
            <p class="m-0 text-sm text-text-secondary">{pilar.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  {
    eventsError ? (
      <section class="border-t border-border py-10 md:py-16">
        <div class="mx-auto max-w-6xl px-4">
          <h2 class="m-0 mb-4 text-3xl font-bold">Próximos eventos</h2>
          <div class="cq-events-error rounded-lg border p-4 text-sm">
            Não foi possível carregar a agenda de eventos no momento. Tente
            novamente mais tarde.
          </div>
        </div>
      </section>
    ) : (
      <HomeEventsSection events={upcoming} eventsHref={eventsHref} />
    )
  }

  <CommunityImpactSection config={config} />
  <CommunityExploreSection config={config} cards={exploreCards} />
  <CommunityChannelsSection config={config} />

  <style>
    .cq-hero {
      background-color: var(--community-primary);
    }
    :global([data-theme="dark"]) .cq-hero {
      background-color: var(--community-primary-dark);
    }
    /* Título/destaque do hero na cor de destaque do tema (accent). */
    .cq-highlight {
      color: var(--community-accent);
    }
    /* CTA primário do hero: fundo accent com texto primaryDark (1:1 do sx
       bgcolor: highlight / color: accentDark do original). */
    .cq-cta-primary {
      background-color: var(--community-accent);
      color: var(--community-primary-dark);
    }
    /* Hover #ffd964: cor literal do sx `bgcolor: "#ffd964"` do original. */
    .cq-cta-primary:hover {
      background-color: #ffd964;
    }
    .cq-events-error {
      border-color: var(--cq-color-warning);
      color: var(--cq-text-secondary);
    }
  </style>
</CommunityLayout>
