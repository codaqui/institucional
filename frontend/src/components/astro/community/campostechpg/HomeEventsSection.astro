---
// Seção "Próximos eventos" da home da CamposTech — port 1:1 (zero JS) de
// `UpcomingEventsSection` em comunidades/campostechpg/src/pages/index.tsx.
// A derivação (filtro por sourceKey, exclui completed, ASC, top 3) vem do
// helper `upcomingCommunityEvents` (src/lib/community-campostechpg.ts) e o
// snapshot é lido em build time pela página (`loadEventsIndex`).
//
// Links: "Ver todos os eventos" e "Ver detalhes" apontam para o portal
// Codaqui — no build codaqui são links relativos (a CamposTech não é tenant,
// então não há o caso de domínio próprio; o prefixo absoluto fica no
// componente caso um build futuro precise, como no devparana).
import type { EventSummary } from "../../../../lib/events";
import { buildEventPublicPath } from "../../../../lib/event-path";
import { formatFullEventDate } from "../../../../lib/community-campostechpg";

interface Props {
  events: EventSummary[];
  /** Link "Ver todos os eventos" (caller resolve portal vs. relativo). */
  eventsHref: string;
  /** Prefixo absoluto do portal Codaqui para os detalhes ("" no build codaqui). */
  portalPrefix?: string;
}

const { events, eventsHref, portalPrefix = "" } = Astro.props;

// Ícones MUI do original (fill currentColor).
const CALENDAR_PATH =
  "M19 4h-1V2h-2v2H8V2H6v2H5c-1.11 0-1.99.9-1.99 2L3 20c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 16H5V10h14v10zM9 14H7v-2h2v2zm4 0h-2v-2h2v2zm4 0h-2v-2h2v2zm-8 4H7v-2h2v2zm4 0h-2v-2h2v2zm4 0h-2v-2h2v2z";
const PLACE_PATH =
  "M12 2C8.13 2 5 5.13 5 8.5c0 5.25 7 13 7 13s7-7.75 7-13C19 5.13 15.87 2 12 2m0 9.5c-1.66 0-3-1.34-3-3s1.34-3 3-3 3 1.34 3 3-1.34 3-3 3";
const FORUM_PATH =
  "M21 6h-2v9H6v2c0 .55.45 1 1 1h11l4 4V7c0-.55-.45-1-1-1m-4 6V3c0-.55-.45-1-1-1H3c-.55 0-1 .45-1 1v14l4-4h10c.55 0 1-.45 1-1";
const OPEN_IN_NEW_PATH =
  "M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3z";
---

<section class="border-t border-border py-10 md:py-16">
  <div class="mx-auto max-w-6xl px-4">
    <div
      class="mb-6 flex flex-col items-start justify-between gap-4 sm:flex-row sm:items-center"
    >
      <div>
        <h2 class="m-0 mb-2 text-3xl font-bold">Próximos eventos</h2>
        <p class="m-0 text-text-secondary">
          Encontros presenciais e online organizados pela CamposTech.
        </p>
      </div>
      <a
        href={eventsHref}
        target="_blank"
        rel="noopener noreferrer"
        class="cq-events-cta inline-flex items-center justify-center rounded-md border px-4 py-2 text-sm font-bold whitespace-nowrap no-underline"
      >
        Ver todos os eventos
      </a>
    </div>

    {
      events.length === 0 && (
        <div class="rounded-lg border border-border bg-surface p-4 text-sm text-text-secondary">
          Nenhum evento próximo publicado no momento. Confira a agenda completa
          para ver eventos passados e futuras atualizações.
        </div>
      )
    }

    <div class="grid gap-6 md:grid-cols-3">
      {
        events.map((event) => (
          <div class="cq-event-card flex h-full flex-col rounded-lg border border-border bg-surface transition duration-200 hover:-translate-y-1 hover:shadow-lg">
            <div class="flex-1 p-4">
              <div
                class="mb-2 flex items-center gap-1.5"
                style="color: var(--community-primary)"
              >
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-4 w-4">
                  <path d={CALENDAR_PATH}></path>
                </svg>
                <span class="text-xs font-bold tracking-wide uppercase">
                  {formatFullEventDate(event.startAt, event.timezone)}
                </span>
              </div>
              <h3 class="m-0 mb-2 text-lg font-bold">{event.title}</h3>
              <div class="mb-1 flex items-center gap-1.5 text-sm text-text-secondary">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-4 w-4">
                  <path d={PLACE_PATH}></path>
                </svg>
                <span>{event.location}</span>
              </div>
              <div class="flex items-center gap-1.5 text-sm text-text-secondary">
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-4 w-4">
                  <path d={FORUM_PATH}></path>
                </svg>
                <span>{event.host}</span>
              </div>
            </div>
            <div class="flex flex-col gap-2 px-4 pt-0 pb-4 sm:flex-row">
              <a
                href={`${portalPrefix}${buildEventPublicPath(event)}`}
                class="cq-event-primary inline-flex flex-1 items-center justify-center rounded-md px-3 py-1.5 text-sm font-bold whitespace-nowrap no-underline"
              >
                Ver detalhes
              </a>
              <a
                href={event.href}
                target="_blank"
                rel="noopener noreferrer"
                class="cq-event-outline inline-flex flex-1 items-center justify-center gap-1 rounded-md border px-3 py-1.5 text-sm font-semibold whitespace-nowrap no-underline"
              >
                Ver na Sympla
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-3.5 w-3.5">
                  <path d={OPEN_IN_NEW_PATH}></path>
                </svg>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .cq-events-cta {
    border-color: var(--community-primary);
    color: var(--community-primary);
  }
  .cq-events-cta:hover {
    background-color: color-mix(in srgb, var(--community-primary) 6%, transparent);
  }
  .cq-event-card:hover {
    border-color: var(--community-primary);
  }
  .cq-event-primary {
    background-color: var(--community-primary);
    color: #fff;
  }
  .cq-event-primary:hover {
    background-color: var(--community-primary-light);
  }
  .cq-event-outline {
    border-color: var(--community-primary);
    color: var(--community-primary);
  }
  .cq-event-outline:hover {
    background-color: color-mix(in srgb, var(--community-primary) 6%, transparent);
  }
</style>
