---

<section class="bg-sunken py-10 md:py-16">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="m-0 mb-4 text-3xl font-bold">{title}</h2>
    <p class="m-0 mb-8 text-text-secondary">{subtitle}</p>
    <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3">
      {
        cards.map((card) => (
          <a
            href={card.to}
            class="block h-full rounded-lg border border-border bg-surface p-6 no-underline transition duration-200 ease-(--cq-motion-ease) hover:-translate-y-1 hover:shadow-lg"
          >
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              class="cq-accent mb-4 h-8 w-8"
            >
              {ICON_PATHS[card.icon].map((d) => (
                <path d={d} />
              ))}
            </svg>
            <h3 class="m-0 mb-2 text-xl font-bold text-text-primary">
              {card.title}
            </h3>
            <p class="m-0 text-sm text-text-secondary">{card.description}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* Ícone do card: --community-primary puro falha AA sobre bg-surface como
   * ícone (≥3:1) — #8DC044 (TI Social) 2.15:1 no claro, #9c27b0
   * (Elas no Código) 2.02:1 no escuro. As variantes dark (claro) / light
   * (escuro) da marca passam com folga nos três tenants. */
  .cq-accent {
    color: var(--community-primary-dark);
  }
  [data-theme="dark"] .cq-accent {
    color: var(--community-primary-light);
  }
</style>
