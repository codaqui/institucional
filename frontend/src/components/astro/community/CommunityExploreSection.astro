---
// Port 1:1 de comunidades/shared/components/CommunityExploreSection.tsx
// (MUI → Astro + Tailwind, zero JS). Os cards vêm do helper puro
// exploreCardsFromConfig (src/lib/community-sections.ts); o ícone de cada
// card usa as variantes dark/light da cor de marca (AA sobre bg-surface).
import type { CommunitySiteConfig } from "../../../../../comunidades/shared/types";
import type {
  CommunityExploreCard,
  CommunityExploreIcon,
} from "../../../lib/community-sections";

interface Props {
  config: CommunitySiteConfig;
  cards: CommunityExploreCard[];
}

const { config, cards } = Astro.props;

const title = config.exploreSection?.title ?? "Explore a comunidade";
const subtitle =
  config.exploreSection?.subtitle ??
  `Tudo que a ${config.shortName} oferece dentro do portal Codaqui.`;

