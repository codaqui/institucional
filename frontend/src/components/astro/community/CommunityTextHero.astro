---
// Port de comunidades/shared/components/CommunityTextHero.tsx (MUI →
// Astro + Tailwind, zero JS), com desvios de contraste AA: o fundo claro é
// --community-primary escurecido via color-mix (o texto branco depende da
// cor de dados do tenant) e o CTA primário usa fundo branco com texto
// primaryDark em ambos os temas. Alternância claro/escuro via seletor
// [data-theme="dark"].
import type { CommunitySiteConfig } from "../../../../../comunidades/shared/types";
import { tenantNavHref } from "../../../lib/community";
import { getTenant } from "../../../lib/tenant";

interface Props {
  config: CommunitySiteConfig;
  /** Chip acima do título; default "Comunidade parceira da Codaqui". */
  chipLabel?: string;
}

const { config, chipLabel = "Comunidade parceira da Codaqui" } = Astro.props;

// CTA primário: mesmo stripBase do nav (C4 — QA wave 0.5): no build tenant
// o link do config nasce limpo (/apoiar), sem o hop 301 do _redirects.
const ctaPrimaryHref = tenantNavHref(
  config.hero.ctaPrimary.to,
  config.basePath,
  getTenant() !== null,
  "https://codaqui.dev",
);

// Ícones MUI (volunteer_activism / open_in_new) como SVG inline — paths do
// @mui/icons-material, fill currentColor.
const VOLUNTEER_ACTIVISM_PATH =
  "M1 11h4v11H1zm15-7.75C16.65 2.49 17.66 2 18.7 2 20.55 2 22 3.45 22 5.3c0 2.27-2.91 4.9-6 7.7-3.09-2.81-6-5.44-6-7.7C10 3.45 11.45 2 13.3 2c1.04 0 2.05.49 2.7 1.25M20 17h-7l-2.09-.73.33-.94L13 16h2.82c.65 0 1.18-.53 1.18-1.18 0-.49-.31-.93-.77-1.11L8.97 11H7v9.02L14 22l8.01-3c-.01-1.1-.9-2-2.01-2";
const OPEN_IN_NEW_PATH =
  "M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3z";
---

<section class="cq-hero text-white">
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-20">
    <div class="max-w-[760px] space-y-6">
      <span class="inline-block w-fit rounded-full bg-black/25 px-3 py-1.5 text-sm font-semibold">
        {chipLabel}
      </span>
      <h1 class="m-0 text-3xl font-extrabold md:text-6xl">
        {config.hero.title}
      </h1>
      <p class="m-0 text-xl font-normal opacity-95">
        {config.hero.subtitle}
      </p>
      <div class="flex flex-col gap-4 pt-2 sm:flex-row">
        <a
          href={ctaPrimaryHref}
          class="cq-hero-primary inline-flex items-center justify-center gap-2 rounded-md px-5 py-2.5 text-sm font-bold no-underline"
        >
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            class="h-5 w-5"
          >
            <path d={VOLUNTEER_ACTIVISM_PATH}></path>
          </svg>
          {config.hero.ctaPrimary.label}
        </a>
        {
          config.hero.ctaSecondary && (
            <a
              href={config.hero.ctaSecondary.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 rounded-md border border-white/70 px-5 py-2.5 text-sm font-bold text-white no-underline transition-colors hover:border-white hover:bg-white/5"
            >
              {config.hero.ctaSecondary.label}
              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                class="h-4 w-4"
              >
                <path d={OPEN_IN_NEW_PATH}></path>
              </svg>
            </a>
          )
        }
      </div>
    </div>
  </div>
</section>

<style>
  /* Fundo claro escurecido via color-mix com preto: --community-primary vem
   * de dados do tenant e o branco do texto precisa de AA — #8DC044 (TI Social)
   * tem só 2.15:1, #1ba250 (DevParaná) 3.32:1. O mix a 62% garante ≥5.15:1
   * nos tenants cadastrados; uma primária ainda mais clara pede ajuste no
   * config da comunidade.
   * No escuro o mesmo mix a 35% mantém a identidade da marca (fundo
   * verde-muito-escuro em vez do cinza neutro do primaryDark de alguns
   * tenants) com contraste ≥10.8:1 do branco (medido: tisocial 10.79,
   * devparana 13.01, elasnocodigo 16.22) — consistência com a estética
   * "dark menos estourado" do restante do tema. */
  .cq-hero {
    background-color: color-mix(in srgb, var(--community-primary) 62%, black);
  }
  :global([data-theme="dark"]) .cq-hero {
    background-color: color-mix(in srgb, var(--community-primary) 35%, black);
  }
  /* CTA primário (ambos os temas): fundo branco com texto primaryDark
   * (≥5.4:1 sobre branco nos três tenants). O dark invertia para bg
   * --community-primary com texto branco e falhava AA (2.15:1 / 3.32:1). */
  .cq-hero-primary {
    background-color: #fff;
    color: var(--community-primary-dark);
  }
  .cq-hero-primary:hover {
    background-color: #f1f5f9;
  }
</style>
