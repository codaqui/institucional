---
// Port de src/components/CommunityPresenceCard (Docusaurus + MUI) para
// Astro + Tailwind (tokens --cq-*). Tooltip do MUI vira atributo `title`;
// ícones de plataforma viram SVG inline (mesmos paths dos MUI icons) ou emoji.
import type { SocialStatEntry } from "../../data/social-stats";
import { PLATFORM_COLORS } from "../../data/social";

export interface Props {
  entityId: string;
  name: string;
  logo: string;
  description: string;
  profiles: SocialStatEntry[];
  location?: string;
  tags?: string[];
  /** Botões outlined no rodapé (links da comunidade) */
  links?: { label: string; url: string }[];
  /** Link textual sutil abaixo dos chips — para um único site primário */
  primaryLink?: { label: string; url: string };
}

const {
  entityId,
  name,
  logo,
  description,
  profiles,
  location,
  tags,
  links,
  primaryLink,
} = Astro.props;

// Paths SVG (viewBox 24) — mesmos dos @mui/icons-material usados no original.
const SVG_PATHS: Record<string, string> = {
  groups:
    "M12 12.75c1.63 0 3.07.39 4.24.9 1.08.48 1.76 1.56 1.76 2.73V18H6v-1.61c0-1.18.68-2.26 1.76-2.73 1.17-.52 2.61-.91 4.24-.91M4 13c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2m1.13 1.1c-.37-.06-.74-.1-1.13-.1-.99 0-1.93.21-2.78.58C2.48 15.05 2 16.43 2 17.35V20h3.5v-1.61c0-.83.23-1.61.63-2.29M20 13c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2m1.13 1.1c.37-.06.74-.1 1.13-.1.99 0 1.93.21 2.78.58.74.47 1.22 1.15 1.22 2.77V20h-3.5v-1.61c0-.83-.23-1.61-.63-2.29M12 6c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3m0 2c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1",
  event:
    "M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z",
  youtube:
    "M10 15l5.19-3L10 9v6m11.56-7.83c.13.47.22 1.1.28 1.9.07.8.1 1.49.1 2.09L22 12c0 2.19-.16 3.8-.44 4.83-.25.9-.83 1.48-1.73 1.73-.47.13-1.33.22-2.65.28-1.3.07-2.49.1-3.59.1L12 19c-4.19 0-6.8-.16-7.83-.44-.9-.25-1.48-.83-1.73-1.73-.13-.47-.22-1.1-.28-1.9-.07-.8-.1-1.49-.1-2.09L2 12c0-2.19.16-3.8.44-4.83.25-.9.83-1.48 1.73-1.73.47-.13 1.33-.22 2.65-.28 1.3-.07 2.49-.1 3.59-.1L12 5c4.19 0 6.8.16 7.83.44.9.25 1.48.83 1.73 1.73z",
  instagram:
    "M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z",
  github:
    "M12 1.27a11 11 0 00-3.48 21.46c.55.09.73-.28.73-.55v-1.84c-3.03.64-3.67-1.46-3.67-1.46-.55-1.29-1.28-1.65-1.28-1.65-.92-.65.1-.65.1-.65 1.1 0 1.73 1.1 1.73 1.1.92 1.65 2.57 1.2 3.21.92a2 2 0 01.64-1.47c-2.47-.27-5.04-1.19-5.04-5.5 0-1.1.46-2.1 1.2-2.84a3.76 3.76 0 010-2.93s.91-.28 3.11 1.1c1.8-.49 3.7-.49 5.5 0 2.1-1.38 3.02-1.1 3.02-1.1a3.76 3.76 0 010 2.93c.83.74 1.2 1.74 1.2 2.94 0 4.21-2.57 5.13-5.04 5.4.45.37.82.92.82 2.02v3.03c0 .27.1.64.73.55A11 11 0 0012 1.27",
};

type PlatformIcon =
  | { kind: "svg"; path: string }
  | { kind: "emoji"; char: string }
  | { kind: "img"; src: string; alt: string };

const PLATFORM_META: Record<
  string,
  { icon: PlatformIcon; label: string }
> = {
  discord: { icon: { kind: "svg", path: SVG_PATHS.groups }, label: "Discord" },
  meetup: { icon: { kind: "svg", path: SVG_PATHS.event }, label: "Meetup" },
  youtube: { icon: { kind: "svg", path: SVG_PATHS.youtube }, label: "YouTube" },
  instagram: {
    icon: { kind: "svg", path: SVG_PATHS.instagram },
    label: "Instagram",
  },
  github: { icon: { kind: "svg", path: SVG_PATHS.github }, label: "GitHub" },
  cncf: {
    icon: { kind: "img", src: "/img/cncf-logo.png", alt: "CNCF" },
    label: "CNCF",
  },
  website: { icon: { kind: "emoji", char: "🌐" }, label: "Website" },
  twitter: { icon: { kind: "emoji", char: "𝕏" }, label: "Twitter/X" },
  whatsapp: { icon: { kind: "emoji", char: "💬" }, label: "WhatsApp" },
};

/** Resolve tokens MUI ("text.primary") para os tokens CSS --cq-* equivalentes. */
function platformColor(platform: string): string {
  const raw = PLATFORM_COLORS[platform] ?? "text.primary";
  if (raw === "text.primary") return "var(--cq-text-primary)";
  if (raw === "text.secondary") return "var(--cq-text-secondary)";
  return raw;
}

function formatCount(n: number): string {
  if (n >= 1000) return `${(n / 1000).toFixed(1).replace(".0", "")}K`;
  return n > 0 ? String(n) : "–";
}

function chipTitle(entry: SocialStatEntry, hasCount: boolean): string {
  if (!hasCount) return `${entry.handle} — clique para visitar`;
  if (entry.isFallback) return "Valor estimado — ainda não sincronizado";
  const when = entry.fetchedAt
    ? new Date(entry.fetchedAt).toLocaleDateString("pt-BR")
    : "—";
  return `Atualizado em ${when}`;
}

const isLocal = logo.startsWith("/img/");

// Remove links já cobertos por um chip social (mesma URL normalizada)
const normalize = (url: string) => url.replace(/\/$/, "").toLowerCase();
const chipUrls = new Set(profiles.map((p) => normalize(p.url)));
const visibleLinks = (links ?? []).filter((l) => !chipUrls.has(normalize(l.url)));
---

<article
  data-entity-id={entityId}
  class="flex h-full flex-col rounded-lg border border-border bg-surface transition-shadow duration-200 hover:shadow-md"
>
  <div class="grow p-4">
    <div class="mb-0.5 flex items-center gap-4">
      <span
        class:list={[
          "inline-flex h-11 w-11 shrink-0 items-center justify-center overflow-hidden rounded-full border border-border bg-surface",
          isLocal && "cpc-logo-local",
        ]}
      >
        <img
          src={logo}
          alt={name}
          width="44"
          height="44"
          loading="lazy"
          class="h-full w-full object-contain p-0.5"
        />
      </span>
      <div>
        <h3 class="text-lg leading-[1.2] font-bold">{name}</h3>
        {location && <p class="text-xs text-text-secondary">📍 {location}</p>}
      </div>
    </div>

    <p class="mt-2 mb-3 text-sm text-text-secondary">{description}</p>

    <div class:list={["flex flex-wrap gap-2", tags?.length && "mb-3"]}>
      {
        profiles.length === 0 ? (
          <p class="text-xs text-text-secondary/70">
            Estatísticas ainda não disponíveis
          </p>
        ) : (
          profiles.map((p) => {
            const hasCount = !p.isFallback || p.count > 0;
            const color = platformColor(p.platform);
            const meta = PLATFORM_META[p.platform];
            return (
              <a
                href={p.url}
                target="_blank"
                rel="noopener noreferrer"
                title={chipTitle(p, hasCount)}
                class="inline-flex items-center gap-1.5 rounded-full border border-border px-2.5 py-1 text-xs text-text-primary transition-colors hover:bg-sunken"
              >
                {meta?.icon.kind === "svg" && (
                  <svg
                    viewBox="0 0 24 24"
                    width="14"
                    height="14"
                    fill="currentColor"
                    aria-hidden="true"
                    style={`color: ${color}`}
                  >
                    <path d={meta.icon.path} />
                  </svg>
                )}
                {meta?.icon.kind === "emoji" && (
                  <span aria-hidden="true" class="text-[13px] leading-none font-extrabold">
                    {meta.icon.char}
                  </span>
                )}
                {meta?.icon.kind === "img" && (
                  <img
                    src={meta.icon.src}
                    alt={meta.icon.alt}
                    width="16"
                    height="16"
                    loading="lazy"
                    class="h-4 w-4 rounded-full"
                  />
                )}
                {hasCount ? (
                  <span>
                    <strong class="font-extrabold">{formatCount(p.count)}</strong>{" "}
                    <span class="opacity-80">{p.countLabel}</span>
                    {p.isFallback && (
                      <span class="ml-0.5 text-[0.7rem] opacity-50">~</span>
                    )}
                  </span>
                ) : (
                  <span class="opacity-85">{p.handle}</span>
                )}
              </a>
            );
          })
        )
      }
    </div>

    {
      tags && tags.length > 0 && (
        <div class:list={["flex flex-wrap gap-1", primaryLink && "mb-2"]}>
          {tags.map((t) => (
            <span class="rounded-full border border-border px-2 py-0.5 text-xs text-text-secondary">
              {t}
            </span>
          ))}
        </div>
      )
    }

    {
      primaryLink && !links?.length && (
        <a
          href={primaryLink.url}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-1 inline-flex items-center gap-1 text-sm font-semibold text-link normal-case hover:text-link-hover"
        >
          {primaryLink.label}
          <svg
            viewBox="0 0 24 24"
            width="14"
            height="14"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2v7zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3h-7z" />
          </svg>
        </a>
      )
    }
  </div>

  {
    visibleLinks.length > 0 && (
      <div class="flex flex-wrap gap-2 px-4 pt-0 pb-4">
        {visibleLinks.map((link) => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-lg border border-border px-3 py-1 text-sm font-semibold text-link transition-colors hover:bg-sunken"
          >
            {link.label}
          </a>
        ))}
      </div>
    )
  }
</article>

<style>
  /* Logos locais (claros por padrão) precisam de inversão no tema escuro —
     mesmo comportamento do Avatar do original. */
  :global([data-theme="dark"]) .cpc-logo-local img {
    filter: invert(1) brightness(2);
  }
</style>
