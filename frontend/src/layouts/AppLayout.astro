---
import BaseLayout from "./BaseLayout.astro";
import BrandLogo from "../components/astro/BrandLogo.astro";
import AppNavIsland from "../components/islands/AppNavIsland";

interface Props {
  /** Título exibido na topbar (curto, ex.: "Eventos"). */
  title: string;
  /** Title tag/OG; default `${title} | CODAQUI.dev` (paridade com o Docusaurus). */
  pageTitle?: string;
  noindex?: boolean;
}

const { title, pageTitle } = Astro.props;
const currentPath = Astro.url.pathname;
const docTitle = pageTitle ?? `${title} | CODAQUI.dev`;

const menuIconClass = "h-5 w-5";
const menuButtonClass =
  "inline-flex cursor-pointer rounded-md p-2 text-text-secondary transition-colors hover:bg-sunken hover:text-text-primary md:hidden";
---

<BaseLayout {...Astro.props} title={docTitle}>
  <div class="flex min-h-screen flex-col">
    <header
      class="sticky top-0 z-30 flex h-14 items-center gap-2 border-b border-border bg-surface px-4"
    >
      <button
        type="button"
        id="app-nav-open"
        class={menuButtonClass}
        aria-label="Abrir navegação"
        aria-expanded="false"
        aria-controls="app-nav-drawer"
      >
        <svg
          class={menuIconClass}
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
      <BrandLogo class="h-7 w-auto" />
      <span class="text-sm font-bold text-text-secondary">Painel</span>
      <span class="text-sm text-text-secondary" aria-hidden="true">›</span>
      <h1 class="text-sm font-bold text-text-primary">{title}</h1>
      <div class="ms-auto flex items-center gap-3">
        <slot name="header" />
        <a href="/" class="text-sm text-link hover:text-link-hover">
          ← Voltar ao site
        </a>
      </div>
    </header>
    <div class="flex min-h-0 flex-1">
      <aside
        id="app-nav-drawer"
        popover="manual"
        tabindex="-1"
        aria-label="Navegação do painel"
        class="app-nav-drawer fixed inset-y-0 left-0 z-40 m-0 flex w-60 -translate-x-full flex-col border-e border-border bg-surface p-0 transition-transform duration-200 ease-(--cq-motion-ease) md:static md:z-auto md:translate-x-0"
      >
        <div
          class="flex items-center justify-between gap-2 border-b border-border px-3 py-2 md:hidden"
        >
          <BrandLogo class="h-6 w-auto" />
          <button type="button" id="app-nav-close" class={menuButtonClass} aria-label="Fechar navegação">
            <svg
              class={menuIconClass}
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              aria-hidden="true"
            >
              <path d="M6 6l12 12M18 6L6 18"></path>
            </svg>
          </button>
        </div>
        <div class="min-h-0 flex-1 overflow-y-auto">
          <AppNavIsland client:load currentPath={currentPath} />
        </div>
      </aside>
      <main class="min-w-0 flex-1">
        <div class="mx-auto w-full max-w-6xl px-4 py-6">
          <slot />
        </div>
      </main>
    </div>
  </div>
</BaseLayout>

<style>
  .app-nav-drawer::backdrop {
    background: rgb(0 0 0 / 0.45);
  }
  .app-nav-drawer:popover-open {
    transform: translateX(0);
  }
  @media (min-width: 768px) {
    .app-nav-drawer {
      display: flex;
      position: static;
      height: auto;
      overflow: visible;
    }
  }
</style>

<script>
  import { focusableIn, nextTrapTarget } from "../lib/header-menu";

  const drawer = document.getElementById("app-nav-drawer");
  const trigger = document.getElementById("app-nav-open");
  const main = document.querySelector("main");

  if (drawer instanceof HTMLElement && trigger instanceof HTMLButtonElement) {
    let lastFocused: HTMLElement | null = null;

    const openDrawer = () => {
      lastFocused = document.activeElement as HTMLElement | null;
      drawer.showPopover();
      main?.setAttribute("inert", "");
      trigger.setAttribute("aria-expanded", "true");
      drawer.focus();
    };
    const closeDrawer = () => {
      if (!drawer.matches(":popover-open")) return;
      drawer.hidePopover();
      main?.removeAttribute("inert");
      trigger.setAttribute("aria-expanded", "false");
      lastFocused?.focus();
    };

    trigger.addEventListener("click", openDrawer);
    drawer.querySelector("#app-nav-close")?.addEventListener("click", closeDrawer);
    drawer.addEventListener("click", (event) => {
      if (event.target === drawer) closeDrawer();
    });
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape") closeDrawer();
    });
    drawer.addEventListener("keydown", (event) => {
      if (event.key !== "Tab") return;
      const next = nextTrapTarget(focusableIn(drawer), document.activeElement, event.shiftKey);
      if (next) {
        event.preventDefault();
        next.focus();
      }
    });
  }
</script>
