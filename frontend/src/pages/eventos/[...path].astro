---
import PublicLayout from "../../layouts/PublicLayout.astro";
import EventRegistrationIsland from "../../components/islands/EventRegistrationIsland";
import AdultContentNotice from "../../components/astro/AdultContentNotice.astro";
import { loadEventsIndex, type EventSummary } from "../../lib/events";
import { loadC4pIndex, type C4pSnapshotCall } from "../../lib/c4p";
import { findPublicC4pForEvent } from "../../lib/event-c4p";
import {
  buildEventJsonLd,
  buildEventPublicPath,
  eventRouteParam,
  resolveEventImageUrl,
  truncateEventSummary,
} from "../../lib/event-path";

export function getStaticPaths() {
  const { calls } = loadC4pIndex();
  return loadEventsIndex().events.map((event) => ({
    params: { path: eventRouteParam(event) },
    props: { event, c4pCall: findPublicC4pForEvent(event, calls) },
  }));
}

interface Props {
  event: EventSummary;
  c4pCall: C4pSnapshotCall | null;
}

const { event, c4pCall } = Astro.props;
const absoluteUrl = new URL(buildEventPublicPath(event), Astro.site).toString();
const jsonLd = buildEventJsonLd(event, absoluteUrl);
const description = truncateEventSummary(event.summary ?? "");
// .origin (sem barra final): resolveEventImageUrl concatena `${siteUrl}${path}`.
const ogImage = resolveEventImageUrl(event.imageUrl, Astro.site?.origin ?? "");

const dateFmt = new Intl.DateTimeFormat("pt-BR", {
  dateStyle: "full",
  timeStyle: "short",
  timeZone: event.timezone || "America/Sao_Paulo",
});
const start = new Date(event.startAt);
const isPast = event.status === "completed" || event.status === "canceled";
---

<PublicLayout title={`${event.title} | CODAQUI.dev`} ogTitle={`${event.title} | CODAQUI.dev`} description={description} ogImage={ogImage} jsonLd={jsonLd}>
  <article class="mx-auto max-w-3xl px-4 py-10">
    <p class="text-sm font-bold text-text-secondary">{event.host}</p>
    <h1 class="mt-1 text-3xl font-extrabold text-text-primary">{event.title}</h1>
    <p class="mt-4 text-text-secondary">
      📅 <time datetime={event.startAt}>{dateFmt.format(start)}</time><br />
      📍 {event.location}
    </p>
    {event.tags.length > 0 && (
      <ul class="mt-3 flex flex-wrap gap-2">
        {event.tags.map((tag) => (
          <li class="rounded-full bg-sunken px-3 py-1 text-xs font-bold text-text-secondary">{tag}</li>
        ))}
      </ul>
    )}
    <p class="mt-6 text-lg text-text-primary">{event.summary}</p>

    {event.adultOnly && (
      <div class="mt-6">
        <AdultContentNotice />
      </div>
    )}

    {c4pCall && (
      <section class="mt-8 rounded-xl border border-border bg-surface p-6 shadow-sm" aria-labelledby="event-c4p-title">
        <p class="text-sm font-bold text-text-secondary">Chamada de trabalhos</p>
        <h2 id="event-c4p-title" class="mt-1 text-2xl font-extrabold text-text-primary">{c4pCall.name}</h2>
        {c4pCall.description && <p class="mt-3 text-text-secondary">{c4pCall.description}</p>}
        {c4pCall.status === "open" ? (
          <a
            href={`/c4p/${c4pCall.slug}/submeter`}
            class="mt-4 inline-flex rounded-lg bg-action px-5 py-2.5 font-bold text-on-action no-underline hover:opacity-90"
          >
            Submeter palestra
          </a>
        ) : c4pCall.publicResults ? (
          <div class="mt-4">
            <h3 class="text-lg font-bold text-text-primary">Palestras selecionadas</h3>
            <ul class="mt-2 list-disc space-y-1 ps-5 text-text-secondary">
              {c4pCall.results?.talks.map((talk) => (
                <li>
                  <strong class="text-text-primary">{talk.title}</strong> — {talk.speakerName}
                  {(talk.track || talk.level) && ` · ${[talk.track, talk.level].filter(Boolean).join(" · ")}`}
                </li>
              ))}
            </ul>
            <a href={`/c4p/${c4pCall.slug}/resultado`} class="mt-3 inline-flex font-bold text-link hover:text-link-hover">
              Ver resultado completo
            </a>
          </div>
        ) : (
          <p class="mt-3 text-text-secondary">A chamada de trabalhos foi encerrada.</p>
        )}
      </section>
    )}

    {!isPast && (
      <section class="mt-8 rounded-xl border border-border bg-surface p-6 shadow-sm">
        <EventRegistrationIsland
          client:only="react"
          eventId={event.id}
          source={event.source}
          externalHref={event.href}
          ctaLabel={event.ctaLabel}
        />
      </section>
    )}

    {event.description && (
      <section class="prose mt-10 max-w-none text-text-primary">
        <h2>Sobre o evento</h2>
        <p style="white-space: pre-line">{event.description}</p>
      </section>
    )}
  </article>
</PublicLayout>
