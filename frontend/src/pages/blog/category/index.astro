---
import { getCollection } from "astro:content";
import PublicLayout from "../../../layouts/PublicLayout.astro";
import { collectByTag } from "../../../lib/blog-utils";

const byTag = collectByTag(await getCollection("blog"));
const tags = [...byTag.entries()]
  .map(([slug, { label, posts }]) => ({ slug, label, count: posts.length }))
  .sort((a, b) => a.label.localeCompare(b.label, "pt-BR"));

// Agrupa por letra inicial (sem acento, maiúscula), como o índice de etiquetas do Docusaurus.
const groups = new Map<string, typeof tags>();
for (const tag of tags) {
  const letter = tag.label
    .normalize("NFD")
    .replace(/\p{M}/gu, "")
    .charAt(0)
    .toUpperCase();
  const list = groups.get(letter) ?? [];
  list.push(tag);
  groups.set(letter, list);
}
const sections = [...groups.entries()].sort(([a], [b]) => a.localeCompare(b, "pt-BR"));
---

<PublicLayout
  title="Etiquetas | CODAQUI.dev"
  ogTitle="Etiquetas | CODAQUI.dev"
  description="Todas as etiquetas dos posts do blog da Codaqui."
>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <h1 class="mb-6 text-3xl font-extrabold text-text-primary">Etiquetas</h1>
    {
      sections.map(([letter, letterTags]) => (
        <section class="mb-8">
          <h2 class="mb-3 text-xl font-bold text-text-primary">{letter}</h2>
          <ul class="flex flex-wrap gap-2">
            {letterTags.map((tag) => (
              <li>
                <a
                  href={`/blog/category/${tag.slug}`}
                  aria-label={`${tag.label} — ${tag.count} ${tag.count === 1 ? "publicação" : "publicações"}`}
                  class="rounded-full border border-border px-3 py-1 text-xs font-semibold text-text-secondary hover:bg-sunken"
                >
                  {tag.label}
                  <span class="ml-1 rounded-full bg-sunken px-1.5 py-0.5 text-text-primary">{tag.count}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
</PublicLayout>
