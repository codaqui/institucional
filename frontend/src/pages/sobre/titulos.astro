---
// Portado de src/pages/sobre/titulos.tsx (Docusaurus + MUI → Astro + Tailwind).
import PublicLayout from "../../layouts/PublicLayout.astro";
import PageHero from "../../components/astro/PageHero.astro";
import { titulos } from "../../data/titulos";

const OPEN_IN_NEW_PATH =
  "M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3z";
---

<PublicLayout
  title="Títulos e Reconhecimentos | CODAQUI.dev"
  ogTitle="Títulos e Reconhecimentos | CODAQUI.dev"
  description="Títulos e reconhecimentos oficiais da Associação Codaqui: Selo OSC do IPEA (Mapa das Organizações da Sociedade Civil), declaração de utilidade pública municipal (Lei nº 12.181/2026, Maringá-PR) e marca registrada no INPI."
>
  <PageHero
    eyebrow="Associação Codaqui"
    title="Títulos e Reconhecimentos"
    subtitle="Selos, leis e reconhecimentos oficiais que atestam o trabalho e a regularidade da Associação Codaqui."
  />

  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
      {
        titulos.map((titulo) => (
          <div class="flex h-full flex-col rounded-lg border border-border bg-surface shadow-sm transition-all duration-200 hover:-translate-y-1 hover:shadow-lg">
            <div class="grow p-4">
              {titulo.destaque && (
                <span class="mb-4 inline-block rounded-full bg-link px-2.5 py-0.5 text-xs font-semibold text-white">
                  {titulo.destaque}
                </span>
              )}

              {titulo.imagem && (
                <div class="mb-4 inline-block rounded-lg border border-border bg-white p-3">
                  <img
                    src={titulo.imagem}
                    alt={titulo.imagemAlt ?? titulo.titulo}
                    height="44"
                    loading="lazy"
                    class="block h-11 w-auto"
                  />
                </div>
              )}

              <h2 class="mb-2 text-2xl font-bold">{titulo.titulo}</h2>

              {titulo.orgao && (
                <p class="mb-2 block text-xs uppercase leading-[1.4] tracking-wide text-text-secondary">
                  {titulo.orgao}
                </p>
              )}

              <p class="mb-4 text-sm text-text-secondary">{titulo.descricao}</p>

              {titulo.metadados && (
                <dl class="m-0 mt-2">
                  {titulo.metadados.map((metadado, i) => (
                    <div
                      class:list={[
                        "flex gap-2 py-1",
                        i < titulo.metadados!.length - 1 &&
                          "border-b border-dashed border-border",
                      ]}
                    >
                      <dt class="min-w-[104px] shrink-0 text-sm font-semibold">
                        {metadado.label}
                      </dt>
                      <dd class="m-0 text-sm text-text-secondary">{metadado.value}</dd>
                    </div>
                  ))}
                </dl>
              )}
            </div>

            <div class="flex flex-wrap gap-1 p-4 pt-0">
              {titulo.links.map((link) => (
                <a
                  href={link.url}
                  target={link.external ? "_blank" : undefined}
                  rel={link.external ? "noopener noreferrer" : undefined}
                  class="inline-flex items-center gap-1 rounded-lg px-3 py-1 text-sm font-semibold text-link no-underline transition-colors hover:bg-sunken"
                >
                  {link.label}
                  {link.external && (
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      width="24"
                      height="24"
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                      class="h-4 w-4"
                    >
                      <path d={OPEN_IN_NEW_PATH} />
                    </svg>
                  )}
                </a>
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</PublicLayout>
