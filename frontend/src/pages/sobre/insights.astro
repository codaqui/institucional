---
// Portado de src/pages/sobre/insights.tsx (Docusaurus + MUI → Astro + Tailwind).
// Social stats: fetch runtime (hook) → loadSocialStats() em build-time (lib).
// Timeline: layout alternado no desktop via grid; expander "+N detalhes" vira
// <details> nativo (zero JS). Ilha: SiteAnalyticsIsland (MUI, client:visible).
import PublicLayout from "../../layouts/PublicLayout.astro";
import StatCard from "../../components/astro/StatCard.astro";
import CommunityPresenceCard from "../../components/astro/CommunityPresenceCard.astro";
import SiteAnalyticsIsland from "../../components/islands/SiteAnalyticsIsland";
import { timelineEvents, type TimelineEvent } from "../../data/timeline";
import { communities } from "../../data/communities";
import { loadSocialStats, profilesFor } from "../../lib/social-stats";

const snapshot = loadSocialStats();

// Hero stats: eventos + discord + meetup devparana (mesma lógica do original)
const totalEvents = snapshot.totalEvents;
const discordCount =
  snapshot.profiles.find((p) => p.entityId === "codaqui" && p.platform === "discord")
    ?.count ?? 0;
const meetupCount =
  snapshot.profiles.find((p) => p.entityId === "devparana" && p.platform === "meetup")
    ?.count ?? 0;

// Paths SVG (viewBox 24) — mesmos dos @mui/icons-material do original.
const ICONS = {
  event:
    "M17 12h-5v5h5v-5zM16 1v2H8V1H6v2H5c-1.11 0-1.99.9-1.99 2L3 19c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2h-1V1h-2zm3 18H5V8h14v11z",
  groups:
    "M12 12.75c1.63 0 3.07.39 4.24.9 1.08.48 1.76 1.56 1.76 2.73V18H6v-1.61c0-1.18.68-2.26 1.76-2.73 1.17-.52 2.61-.91 4.24-.91M4 13c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2m1.13 1.1c-.37-.06-.74-.1-1.13-.1-.99 0-1.93.21-2.78.58C2.48 15.05 2 16.43 2 17.35V20h3.5v-1.61c0-.83.23-1.61.63-2.29M20 13c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2m1.13 1.1c.37-.06.74-.1 1.13-.1.99 0 1.93.21 2.78.58.74.47 1.22 1.15 1.22 2.77V20h-3.5v-1.61c0-.83-.23-1.61-.63-2.29M12 6c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3m0 2c-.55 0-1 .45-1 1s.45 1 1 1 1-.45 1-1-.45-1-1-1",
  peopleAlt:
    "M16.67 13.13C18.04 14.06 19 15.32 19 17v3h4v-3c0-2.18-3.57-3.47-6.33-3.87M15 12c2.21 0 4-1.79 4-4s-1.79-4-4-4c-.47 0-.91.1-1.33.26C14.5 5.27 15 6.58 15 8s-.5 2.73-1.33 3.74c.42.16.86.26 1.33.26m-6 0c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4m0-6c1.1 0 2 .9 2 2s-.9 2-2 2-2-.9-2-2 .9-2 2-2m0 7c-2.67 0-8 1.34-8 4v3h16v-3c0-2.66-5.33-4-8-4m6 5H3v-.99C3.2 16.29 6.3 15 9 15s5.8 1.29 6 2v1z",
  school:
    "M5 13.18v4L12 21l7-3.82v-4L12 17l-7-3.82M12 3 1 9l11 6 9-4.91V17h2V9L12 3z",
  accessTime:
    "M11.99 2C6.47 2 2 6.48 2 12s4.47 10 9.99 10C17.52 22 22 17.52 22 12S17.52 2 11.99 2M12 20c-4.42 0-8-3.58-8-8s3.58-8 8-8 8 3.58 8 8-3.58 8-8 8m.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67z",
};

const heroStats = [
  { icon: ICONS.event, value: `${totalEvents}+`, label: "Eventos organizados" },
  {
    icon: ICONS.groups,
    value: discordCount > 0 ? discordCount.toLocaleString("pt-BR") : "–",
    label: "Membros no Discord",
  },
  {
    icon: ICONS.peopleAlt,
    value: meetupCount > 0 ? meetupCount.toLocaleString("pt-BR") : "–",
    label: "Membros no Meetup",
  },
  { icon: ICONS.school, value: "126+", label: "Mentorias realizadas" },
  { icon: ICONS.accessTime, value: "89h+", label: "Horas de mentoria" },
];

// Mesmo COLOR_MAP do original, resolvido para tokens --cq-*.
const COLOR_MAP: Record<TimelineEvent["color"], string> = {
  success: "var(--cq-color-success)",
  info: "var(--cq-color-info)",
  warning: "var(--cq-color-warning)",
  error: "var(--cq-color-error)",
  primary: "var(--cq-color-primary-500)",
  secondary: "var(--cq-color-primary-300)",
  grey: "var(--cq-color-neutral-400)",
};

const ITEMS_THRESHOLD = 4;
---

<PublicLayout
  title="Insights | Codaqui"
  ogTitle="Insights | CODAQUI.dev"
  description="Impacto, presença digital e linha do tempo da Codaqui e suas comunidades parceiras"
>
  {/* ── Hero ── */}
  <section class="bg-[linear-gradient(135deg,var(--cq-color-primary-600),var(--cq-color-primary-500))] py-12 text-center md:py-16">
    <div class="mx-auto max-w-3xl px-4">
      <h1 class="text-3xl font-extrabold text-white md:text-4xl">🔍 Insights</h1>
      <p class="mx-auto mt-4 max-w-[600px] text-lg text-white/85">
        Impacto, presença digital e trajetória da Codaqui e das comunidades parceiras
      </p>
    </div>
  </section>

  {/* ── Stats bar ── */}
  <section class="border-b border-border bg-surface">
    <div class="mx-auto max-w-6xl px-4 py-6">
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-5">
        {
          heroStats.map((s) => (
            <StatCard value={s.value} label={s.label} variant="filled">
              <svg
                slot="icon"
                viewBox="0 0 24 24"
                width="24"
                height="24"
                fill="currentColor"
                aria-hidden="true"
                class="mx-auto"
              >
                <path d={s.icon} />
              </svg>
            </StatCard>
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Alcance do Site ── */}
  <SiteAnalyticsIsland client:visible />

  {/* ── Presença Digital ── */}
  <section class="py-10 md:py-14">
    <div class="mx-auto max-w-6xl px-4">
      <h2 class="mb-2 text-2xl font-extrabold">📡 Presença Digital</h2>
      <p class="mb-8 text-text-secondary">
        Canais oficiais da Codaqui e das comunidades parceiras — acompanhe onde estamos.
        Instagram e YouTube aparecem como links diretos (sem API pública de contagem).
      </p>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
        <CommunityPresenceCard
          entityId="codaqui"
          name="Codaqui"
          logo="/img/logo.png"
          description="Associação sem fins lucrativos que democratiza o acesso à educação em tecnologia para jovens."
          profiles={profilesFor(snapshot, "codaqui")}
          tags={["educação", "tecnologia", "inclusão"]}
          primaryLink={{ label: "codaqui.dev", url: "https://codaqui.dev" }}
        />
        {
          communities.map((c) => (
            <CommunityPresenceCard
              entityId={c.id}
              name={`${c.emoji} ${c.name}`}
              logo={c.logo}
              description={c.description}
              profiles={profilesFor(snapshot, c.id)}
              location={c.location}
              tags={c.tags}
              primaryLink={
                c.links[0]
                  ? { label: c.links[0].label, url: c.links[0].url }
                  : undefined
              }
            />
          ))
        }
      </div>
    </div>
  </section>

  {/* ── Linha do Tempo ── */}
  <section class="mx-auto max-w-3xl px-4 py-10 md:py-16">
    <h2 class="mb-2 text-2xl font-extrabold">🕐 Linha do Tempo</h2>
    <p class="mb-10 text-text-secondary">
      De uma conversa em 2020 a centenas de participantes impactados.
    </p>

    <div>
      {
        timelineEvents.map((event, index) => {
          const isEven = index % 2 === 0;
          const isLast = index === timelineEvents.length - 1;
          const isCurrent = event.tag === "Em andamento";
          const accent = COLOR_MAP[event.color];
          const hasMore = event.items.length > ITEMS_THRESHOLD;
          const visibleItems = hasMore
            ? event.items.slice(0, ITEMS_THRESHOLD)
            : event.items;

          const card = (
            <article
              style={`--accent: ${accent}`}
              class:list={[
                "relative overflow-hidden rounded-lg border transition-shadow duration-200 hover:shadow-md",
                isCurrent
                  ? "border-(--accent) bg-sunken"
                  : "border-border bg-surface",
              ]}
            >
              <div class="h-[3px] bg-(--accent)"></div>
              <span
                aria-hidden="true"
                class="pointer-events-none absolute -top-2 right-3 text-7xl leading-none font-black text-text-primary opacity-[0.04] select-none md:text-8xl"
              >
                {event.year}
              </span>
              <div class="p-4 sm:p-5">
                <div class="mb-1.5 flex flex-wrap items-center gap-2">
                  <span aria-hidden="true" class="text-xl leading-none">
                    {event.icon}
                  </span>
                  <h3 class="text-lg leading-[1.2] font-extrabold">{event.label}</h3>
                  {event.tag && (
                    <span
                      class:list={[
                        "rounded-full px-2 py-0.5 text-[0.7rem] font-bold",
                        event.color === "grey"
                          ? "border border-border text-text-secondary"
                          : isCurrent
                            ? "bg-(--accent) text-white"
                            : "border border-(--accent) text-(--accent)",
                      ]}
                    >
                      {event.tag}
                    </span>
                  )}
                </div>

                {event.description && (
                  <p
                    class:list={[
                      "text-sm leading-relaxed text-text-secondary",
                      event.stats?.length ? "mb-4" : "mb-3",
                    ]}
                  >
                    {event.description}
                  </p>
                )}

                {event.stats && event.stats.length > 0 && (
                  <>
                    <div class="mb-4 flex flex-wrap gap-x-4 gap-y-1.5 sm:gap-x-6">
                      {event.stats.map((s) => (
                        <div>
                          <span class="mr-1 text-lg leading-none font-extrabold">
                            {s.value}
                          </span>
                          <span class="text-xs font-semibold tracking-[0.05em] text-text-secondary uppercase">
                            {s.label}
                          </span>
                        </div>
                      ))}
                    </div>
                    <hr class="mb-3 border-border" />
                  </>
                )}

                {event.highlights && event.highlights.length > 0 && (
                  <div class="mb-3 border-s-[3px] border-(--accent) ps-3">
                    {event.highlights.map((h) => (
                      <p class="text-sm leading-normal font-semibold">{h}</p>
                    ))}
                  </div>
                )}

                <ul class="m-0 list-disc ps-4 [&_li+li]:mt-1">
                  {visibleItems.map((item) => (
                    <li class="text-sm text-text-secondary">{item}</li>
                  ))}
                </ul>
                {hasMore && (
                  <details class="tl-more mt-2">
                    <summary class="inline-flex cursor-pointer list-none items-center gap-1 text-sm text-text-secondary select-none [&::-webkit-details-marker]:hidden">
                      <span class="tl-more-open-label">
                        +{event.items.length - ITEMS_THRESHOLD} detalhes
                      </span>
                      <span class="tl-more-close-label">Recolher</span>
                      <svg
                        viewBox="0 0 24 24"
                        width="18"
                        height="18"
                        fill="currentColor"
                        aria-hidden="true"
                        class="tl-more-chevron"
                      >
                        <path d="M16.59 8.59 12 13.17 7.41 8.59 6 10l6 6 6-6z" />
                      </svg>
                    </summary>
                    <ul class="m-0 mt-1 list-disc ps-4 [&_li+li]:mt-1">
                      {event.items.slice(ITEMS_THRESHOLD).map((item) => (
                        <li class="text-sm text-text-secondary">{item}</li>
                      ))}
                    </ul>
                  </details>
                )}
              </div>
            </article>
          );

          return (
            <>
              {/* Mobile: linha + dot à esquerda, ano sobre o card */}
              <div class:list={["flex gap-4 md:hidden", !isLast && "mb-1"]}>
                <div class="flex shrink-0 flex-col items-center">
                  <span
                    style={`--accent: ${accent}`}
                    class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-(--accent) text-base shadow-md"
                  >
                    <span aria-hidden="true">{event.icon}</span>
                  </span>
                  {!isLast && (
                    <span class="mt-1 -mb-1 min-h-8 w-0.5 flex-1 bg-border"></span>
                  )}
                </div>
                <div class:list={["flex-1", !isLast && "pb-8"]}>
                  <p class="mb-1.5 block text-xs leading-none font-extrabold tracking-wider text-text-secondary/70 uppercase">
                    {event.year}
                  </p>
                  {card}
                </div>
              </div>

              {/* Desktop: layout alternado com linha central */}
              <div
                class:list={[
                  "hidden grid-cols-[1fr_56px_1fr] items-start md:grid",
                  !isLast && "mb-1",
                ]}
              >
                <div class:list={["pt-2 pr-6 text-right", !isLast && "pb-10"]}>
                  {!isEven && card}
                  {isEven && (
                    <p class="text-4xl leading-none font-black text-text-secondary/35">
                      {event.year}
                    </p>
                  )}
                </div>
                <div class="flex flex-col items-center">
                  <span
                    style={`--accent: ${accent}`}
                    class="z-10 flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-(--accent) text-xl shadow-lg"
                  >
                    <span aria-hidden="true">{event.icon}</span>
                  </span>
                  {!isLast && <span class="min-h-10 w-0.5 flex-1 bg-border"></span>}
                </div>
                <div class:list={["pt-2 pl-6", !isLast && "pb-10"]}>
                  {isEven && card}
                  {!isEven && (
                    <p class="text-4xl leading-none font-black text-text-secondary/35">
                      {event.year}
                    </p>
                  )}
                </div>
              </div>
            </>
          );
        })
      }
    </div>
  </section>
</PublicLayout>

<style>
  /* Expander "+N detalhes" (details nativo): troca de rótulo e chevron ao abrir */
  .tl-more-close-label {
    display: none;
  }
  .tl-more[open] .tl-more-open-label {
    display: none;
  }
  .tl-more[open] .tl-more-close-label {
    display: inline;
  }
  .tl-more[open] .tl-more-chevron {
    transform: rotate(180deg);
  }
  .tl-more-chevron {
    transition: transform 0.2s;
  }
</style>
