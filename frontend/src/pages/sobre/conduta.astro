---
// Portado de src/pages/sobre/conduta.md (Docusaurus MD → Astro content collection `pages`).
import { getEntry, render } from "astro:content";
import PublicLayout from "../../layouts/PublicLayout.astro";

const entry = await getEntry("pages", "conduta");
if (!entry) throw new Error("Página de conteúdo não encontrada: conduta");
const { Content } = await render(entry);

const toc = [
  { href: "#resumo", label: "Resumo" },
  { href: "#1-proposta", label: "1. Proposta" },
  { href: "#2-cidadania", label: "2. Cidadania" },
  { href: "#3-comportamento-esperado", label: "3. Comportamento esperado" },
  { href: "#4-comportamento-inaceitável", label: "4. Comportamento inaceitável" },
  { href: "#5-consequências-do-compartamento-inaceitável", label: "5. Consequências" },
  { href: "#6-diretrizes-para-reportar", label: "6. Como reportar" },
  { href: "#7-concluindo", label: "7. Concluindo" },
  { href: "#8-privacidade-e-proteção-de-dados-lgpd", label: "8. Privacidade e LGPD" },
  { href: "#referências", label: "Referências" },
];
---

<PublicLayout
  title={`${entry.data.title} | CODAQUI.dev`}
  ogTitle={`${entry.data.title} | CODAQUI.dev`}
  description={entry.data.description ?? ""}
>
  <article class="mx-auto max-w-6xl px-4 py-10">
    <header class="mb-8 rounded-2xl border border-border bg-surface p-6">
      <p class="mb-2 text-sm font-bold uppercase tracking-wide text-primary-700">Comunidade e segurança</p>
      <h1 class="mb-3 text-3xl font-extrabold text-text-primary">{entry.data.title}</h1>
      <p class="max-w-3xl text-text-secondary">
        Diretrizes para uma comunidade aberta, acolhedora e livre de assédio.
      </p>
      <div class="mt-5 grid gap-3 sm:grid-cols-3">
        <div class="rounded-lg border border-border p-3">
          <strong class="block text-text-primary">Respeito</strong>
          <span class="text-sm text-text-secondary">Pessoas e origens diversas são bem-vindas.</span>
        </div>
        <div class="rounded-lg border border-border p-3">
          <strong class="block text-text-primary">Colaboração</strong>
          <span class="text-sm text-text-secondary">Diálogo e cooperação antes do conflito.</span>
        </div>
        <div class="rounded-lg border border-border p-3">
          <strong class="block text-text-primary">Segurança</strong>
          <span class="text-sm text-text-secondary">Assédio não é tolerado em nenhum espaço.</span>
        </div>
      </div>
    </header>

    <div class="grid gap-8 lg:grid-cols-[220px_minmax(0,1fr)]">
      <aside class="lg:sticky lg:top-24 lg:self-start" aria-label="Nesta página">
        <details class="rounded-lg border border-border bg-surface p-4 lg:open">
          <summary class="cursor-pointer font-bold text-text-primary lg:hidden">Nesta página</summary>
          <h2 class="mb-3 hidden text-sm font-bold uppercase tracking-wide text-text-secondary lg:block">
            Nesta página
          </h2>
          <nav aria-label="Seções do Código de Conduta">
            <ul class="space-y-2">
              {toc.map((item) => (
                <li>
                  <a href={item.href} class="block rounded px-2 py-1 text-sm text-link hover:bg-sunken">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        </details>
      </aside>

      <div>
        <section class="mb-6 rounded-xl border border-primary-700 bg-surface p-5" aria-labelledby="como-reportar">
          <h2 id="como-reportar" class="mb-2 text-xl font-extrabold text-text-primary">Como reportar</h2>
          <p class="text-text-secondary">
            Se você sofrer ou presenciar comportamento inaceitável, notifique os organizadores o quanto antes.
          </p>
          <a href="mailto:contato@codaqui.dev" class="mt-3 inline-block font-bold text-link hover:text-link-hover">
            contato@codaqui.dev
          </a>
          <p class="mt-3 text-sm text-text-secondary">
            Também consulte a <a href="/sobre/privacidade" class="text-link hover:text-link-hover">Política de Privacidade</a>.
          </p>
        </section>
        <div class="prose-cq">
          <Content />
        </div>
      </div>
    </div>
  </article>
</PublicLayout>

<style is:global>
  @media print {
    header,
    footer,
    aside {
      display: none !important;
    }
    article,
    article > div,
    .grid {
      display: block !important;
      max-width: none !important;
      border: 0 !important;
      box-shadow: none !important;
    }
    a {
      color: inherit !important;
      text-decoration: none !important;
    }
  }
</style>
