---
import PublicLayout from "../../layouts/PublicLayout.astro";
import PageHero from "../../components/astro/PageHero.astro";
import { loadMentorsIndex } from "../../data/mentors";
import { alumni, diretoria, membros } from "../../data/team";
import { loadPublicMembers } from "../../lib/member-pages";
import { enrichTeamMember, toMentorTeamMembers } from "../../lib/team";

const LINKEDIN_PATH =
  "M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z";
const GITHUB_PATH =
  "M12 1.27a11 11 0 00-3.48 21.46c.55.09.73-.28.73-.55v-1.84c-3.03.64-3.67-1.46-3.67-1.46-.55-1.29-1.28-1.65-1.28-1.65-.92-.65.1-.65.1-.65 1.1 0 1.73 1.1 1.73 1.1.92 1.65 2.57 1.2 3.21.92a2 2 0 01.64-1.47c-2.47-.27-5.04-1.19-5.04-5.5 0-1.1.46-2.1 1.2-2.84a3.76 3.76 0 010-2.93s.91-.28 3.11 1.1c1.8-.49 3.7-.49 5.5 0 2.1-1.38 3.02-1.1 3.02-1.1a3.76 3.76 0 010 2.93c.83.74 1.2 1.74 1.2 2.94 0 4.21-2.57 5.13-5.04 5.4.45.37.82.92.82 2.02v3.03c0 .27.1.64.73.55A11 11 0 0012 1.27";

interface CardMember {
  name: string;
  avatar: string;
  role?: string;
  specialty?: string;
  linkedin?: string;
  github?: string;
  handle?: string;
  areas?: string[];
  focus?: string | null;
  profilePath?: string;
}

interface Section {
  id: string;
  title: string;
  members: CardMember[];
  description?: string;
}

const publicMembers = await loadPublicMembers();
const { mentors } = loadMentorsIndex();

const sections: Section[] = [
  {
    id: "diretoria",
    title: "Diretoria",
    description:
      "Responsável pela gestão, representação legal e prestação de contas da associação.",
    members: diretoria.map((member) => enrichTeamMember(member, publicMembers)),
  },
  {
    id: "membros",
    title: "Membros",
    members: membros.map((member) => enrichTeamMember(member, publicMembers)),
  },
  {
    id: "alumni",
    title: "Alumni",
    description:
      "Pessoas que fizeram parte da associação e contribuíram para sua história e fundação.",
    members: alumni.map((member) => enrichTeamMember(member, publicMembers)),
  },
  {
    id: "mentores",
    title: "Mentores",
    description:
      "Nossos mentores participam do programa #QueroMentoria, oferecendo encontros individuais para quem está iniciando na tecnologia.",
    members: toMentorTeamMembers(mentors, publicMembers),
  },
];
---

<PublicLayout
  title="Equipe | CODAQUI.dev"
  ogTitle="Equipe | CODAQUI.dev"
  description="Conheça a diretoria, membros, mentores e alumni da Codaqui"
>
  <PageHero
    eyebrow="Associação Codaqui · CNPJ 44.593.429/0001-05"
    title="Quem somos"
    subtitle="Quebramos barreiras e democratizamos o acesso à tecnologia. Uma associação sem fins lucrativos que atua como guarda-chuva de comunidades tech."
  />

  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    {
      sections.map((section) => (
        <section id={section.id} aria-labelledby={`${section.id}-title`} class="mb-16">
          <h2 id={`${section.id}-title`} class="mb-2 text-2xl font-bold md:text-3xl">
            {section.title}
          </h2>
          {section.description && (
            <p class="mb-6 max-w-[700px] text-text-secondary">{section.description}</p>
          )}
          <hr class="mb-8 border-border" />
          {section.members.length === 0 ? (
            <p class="text-text-secondary">
              Nenhum mentor ativo no momento. Conheça o programa e volte para conferir novas disponibilidades na{" "}
              <a href="/participe/mentoria" class="font-semibold text-link hover:text-link-hover">
                página de mentoria
              </a>
              .
            </p>
          ) : (
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
              {section.members.map((member) => {
                const github = member.github ??
                  (member.handle ? `https://github.com/${member.handle}` : undefined);
                return (
                  <article class="flex h-full flex-col rounded-lg border border-border bg-surface transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md">
                    <div class="flex grow flex-col items-center gap-2 p-4 text-center">
                      <img
                        src={member.avatar}
                        alt={`Foto de ${member.name}`}
                        width="80"
                        height="80"
                        loading="lazy"
                        class="h-20 w-20 rounded-full border-[3px] border-border"
                      />
                      <h3 class="text-lg font-bold">{member.name}</h3>
                      {member.role && (
                        <span class="rounded-full border border-border px-2.5 py-0.5 text-xs">
                          {member.role}
                        </span>
                      )}
                      {member.specialty && (
                        <span class="rounded-full bg-link px-2.5 py-0.5 text-xs font-semibold text-white">
                          {member.specialty}
                        </span>
                      )}
                      {member.focus && (
                        <p class="text-sm text-text-secondary">{member.focus}</p>
                      )}
                      {member.areas && member.areas.length > 0 && (
                        <ul class="m-0 flex list-none flex-wrap justify-center gap-1 p-0" aria-label="Áreas de mentoria">
                          {member.areas.map((area) => (
                            <li class="rounded-full border border-border px-2 py-0.5 text-xs text-text-secondary">
                              {area}
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>
                    <footer class="flex flex-wrap items-center justify-center gap-2 p-4 pt-0">
                      {member.profilePath && (
                        <a
                          href={member.profilePath}
                          aria-label={`Ver perfil público de ${member.name}`}
                          class="rounded-lg px-2 py-2 text-sm font-semibold text-link transition-colors hover:bg-sunken"
                        >
                          Ver perfil
                        </a>
                      )}
                      {member.handle && (
                        <a
                          href="/participe/mentoria"
                          aria-label={`Agendar mentoria com ${member.name}`}
                          class="rounded-lg px-2 py-2 text-sm font-semibold text-link transition-colors hover:bg-sunken"
                        >
                          Agendar mentoria
                        </a>
                      )}
                      {member.linkedin && member.linkedin !== "#" && (
                        <a
                          href={member.linkedin}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`LinkedIn de ${member.name}`}
                          class="inline-flex rounded-lg p-2 text-link transition-colors hover:bg-sunken"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d={LINKEDIN_PATH} />
                          </svg>
                        </a>
                      )}
                      {github && github !== "#" && (
                        <a
                          href={github}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`GitHub de ${member.name}`}
                          class="inline-flex rounded-lg p-2 text-text-primary transition-colors hover:bg-sunken"
                        >
                          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                            <path d={GITHUB_PATH} />
                          </svg>
                        </a>
                      )}
                    </footer>
                  </article>
                );
              })}
            </div>
          )}
        </section>
      ))
    }
  </div>
</PublicLayout>
