const channels: (SocialChannel & { isExternal: boolean })[] = socialChannels.map(
  (c) => ({ ...c, isExternal: c.href.startsWith("http") })
);
---

<PublicLayout
  title="Contato | CODAQUI.dev"
  ogTitle="Contato | CODAQUI.dev"
  description="Entre em contato com a Codaqui"
>
  <PageHero
    eyebrow="Entre em contato"
    title="Fale com a Codaqui"
    subtitle="Escolha o canal que preferir — estamos disponíveis em várias plataformas."
  />
  <div class="mx-auto max-w-3xl px-4 py-12 md:py-16">
    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        channels.map((c) => (
          <a
            href={c.href}
            target={c.isExternal ? "_blank" : undefined}
            rel={c.isExternal ? "noopener noreferrer" : undefined}
            class="flex items-center gap-4 rounded-lg border border-border bg-surface p-5 text-text-primary no-underline transition-all duration-200 hover:-translate-y-0.5 hover:border-link hover:shadow-md"
          >
            <span class="shrink-0 text-link" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="currentColor"
              >
                <path d={iconPaths[c.key]} />
              </svg>
            </span>
            <span class="min-w-0 flex-1">
              <span class="block text-lg font-bold">{c.name}</span>
              <span class="block text-sm text-text-secondary">{c.description}</span>
            </span>
            <span class="shrink-0 rounded-full border border-link px-3 py-0.5 text-xs font-semibold text-link">
              {c.cta}
            </span>
          </a>
        ))
      }
    </div>
  </div>
</PublicLayout>
