---
// Vitrine pública de chamadas de trabalhos (C4P) — renderizada 100% em build
// a partir do snapshot estático (mesmo pattern de /eventos). Submissão e
// resultado vivem nas rotas por slug geradas do mesmo snapshot.
import PublicLayout from "../layouts/PublicLayout.astro";
import PageHero from "../components/astro/PageHero.astro";
import { loadC4pIndex } from "../lib/c4p";

const { calls } = loadC4pIndex();
const openCalls = calls.filter((call) => call.status === "open");
const publishedResults = calls.filter(
  (call) => call.status === "closed" && call.results !== null,
);
---

<PublicLayout
  title="Chamadas de Trabalhos (C4P) | CODAQUI.dev"
  ogTitle="C4P — Chamadas de Trabalhos | CODAQUI.dev"
  description="Submeta palestras para os eventos da Codaqui e das comunidades parceiras: curadoria transparente, resultado publicado e notas nunca expostas."
>
  <PageHero
    eyebrow="Chamadas de trabalhos"
    title="C4P — submeta sua palestra"
    subtitle="Participe das chamadas de trabalhos da Associação Codaqui e das comunidades do ecossistema. Submissão pública, curadoria por avaliadores e resultado publicado."
  />

  <div class="mx-auto max-w-4xl px-4 py-12">
    <section aria-labelledby="abertas">
      <h2 id="abertas" class="text-2xl font-bold text-text-primary">
        Chamadas abertas
      </h2>
      {openCalls.length === 0 ? (
        <p class="mt-4 text-text-secondary">
          Nenhuma chamada aberta no momento. Acompanhe o{" "}
          <a href="/blog" class="text-link">blog</a> e as redes da
          Codaqui para os próximos C4Ps.
        </p>
      ) : (
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {openCalls.map((call) => (
            <li class="rounded-xl border border-border bg-surface p-5 shadow-sm">
              <p class="text-sm font-semibold uppercase tracking-wide text-link">
                {call.community ? call.community.name : "Associação Codaqui"}
              </p>
              <h3 class="mt-1 text-xl font-bold text-text-primary">
                {call.name}
              </h3>
              {call.description ? (
                <p class="mt-2 text-text-secondary">{call.description}</p>
              ) : null}
              {call.submissionCloseAt ? (
                <p class="mt-2 text-sm text-text-secondary">
                  Submissões até{" "}
                  <time datetime={call.submissionCloseAt}>
                    {new Date(call.submissionCloseAt).toLocaleDateString("pt-BR", {
                      timeZone: "America/Sao_Paulo",
                    })}
                  </time>
                </p>
              ) : null}
              <a
                href={`/c4p/${call.slug}/submeter`}
                class="mt-4 inline-flex items-center justify-center rounded-lg bg-action px-4 py-2 font-bold text-white no-underline transition-colors hover:opacity-90"
              >
                Submeter proposta
              </a>
            </li>
          ))}
        </ul>
      )}
    </section>

    {publishedResults.length > 0 ? (
      <section aria-labelledby="resultados" class="mt-12">
        <h2 id="resultados" class="text-2xl font-bold text-text-primary">
          Resultados publicados
        </h2>
        <ul class="mt-6 grid gap-4 sm:grid-cols-2">
          {publishedResults.map((call) => (
            <li class="rounded-xl border border-border bg-surface p-5 shadow-sm">
              <h3 class="text-xl font-bold text-text-primary">
                {call.name}
              </h3>
              <a
                href={`/c4p/${call.slug}/resultado`}
                class="mt-3 inline-flex items-center justify-center rounded-lg border border-border px-4 py-2 font-bold text-link no-underline transition-colors hover:bg-sunken"
              >
                Ver palestras aprovadas
              </a>
            </li>
          ))}
        </ul>
      </section>
    ) : null}
  </div>
</PublicLayout>
