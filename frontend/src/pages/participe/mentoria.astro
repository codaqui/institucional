---
import PublicLayout from "../../layouts/PublicLayout.astro";
import PageHero from "../../components/astro/PageHero.astro";
import MentorDirectoryIsland from "../../components/islands/mentorship/MentorDirectoryIsland";
import MentorApplicationIsland from "../../components/islands/mentorship/MentorApplicationIsland";
import { loadMentorsIndex } from "../../data/mentors";
import { DISCORD_URL } from "../../data/social";

const { mentors, insights } = loadMentorsIndex();
---

<PublicLayout
  title="#QueroMentoria | CODAQUI.dev"
  ogTitle="#QueroMentoria | CODAQUI.dev"
  description="Conectamos você a um mentor experiente para sessões individuais online — de graça."
>
  <PageHero
    eyebrow="Quero Mentoria"
    title="Mentoria Individual"
    subtitle="Escolha um foco, encontre um horário e acompanhe sua sessão em um só lugar — de graça."
  >
    <a href="#agendar" class="rounded-lg bg-white px-6 py-3 font-bold text-primary-900 no-underline transition-colors hover:bg-neutral-100">Agendar uma sessão</a>
  </PageHero>

  <div class="mx-auto max-w-6xl px-4 py-12 md:py-20">
    <section class="mb-16" aria-labelledby="como-funciona">
      <h2 id="como-funciona" class="mb-6 text-3xl font-bold">Como funciona</h2>
      <ol class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <li class="rounded-lg border border-border bg-surface p-6"><span class="text-sm font-bold text-link">01</span><h3 class="mb-2 mt-2 text-xl font-bold">Escolha um mentor</h3><p class="text-text-secondary">Compare áreas e foco para encontrar a experiência mais próxima do seu objetivo.</p></li>
        <li class="rounded-lg border border-border bg-surface p-6"><span class="text-sm font-bold text-link">02</span><h3 class="mb-2 mt-2 text-xl font-bold">Solicite um horário</h3><p class="text-text-secondary">Veja a disponibilidade real das próximas quatro semanas e envie seus temas.</p></li>
        <li class="rounded-lg border border-border bg-surface p-6"><span class="text-sm font-bold text-link">03</span><h3 class="mb-2 mt-2 text-xl font-bold">Acompanhe a sessão</h3><p class="text-text-secondary">Receba a confirmação, acesse o link e avalie a experiência ao final.</p></li>
      </ol>
      <p class="mt-6 text-text-secondary">Programa aberto a qualquer pessoa, sem restrição de idade ou nível de experiência. As sessões acontecem online.</p>
    </section>

    <section id="agendar" class="mb-16" aria-labelledby="mentores-title">
      <div class="mb-6 flex flex-wrap items-end justify-between gap-3">
        <div><h2 id="mentores-title" class="text-3xl font-bold">Mentores e horários</h2><p class="mt-2 text-text-secondary">{insights.activeMentors} mentores ativos · {insights.completed} sessões concluídas</p></div>
        <a href="/membro/mentoria" class="font-semibold text-link">Área do mentor →</a>
      </div>
      <MentorDirectoryIsland mentors={mentors} client:only="react" />
    </section>

    <section class="mb-16 grid grid-cols-1 gap-6 md:grid-cols-2" aria-label="Participação no programa">
      <div class="rounded-lg border border-border bg-surface p-6">
        <h2 class="mb-3 text-2xl font-bold">Quero ser mentor</h2>
        <p class="mb-5 text-text-secondary">Compartilhe sua experiência em sessões voluntárias. As horas concluídas entram na fila existente de aprovação.</p>
        <MentorApplicationIsland client:only="react" />
      </div>
      <div class="rounded-lg border border-border bg-surface p-6">
        <h2 class="mb-3 text-2xl font-bold">Ainda com dúvidas?</h2>
        <p class="mb-5 text-text-secondary">Converse com a comunidade antes de escolher um horário ou conheça outras formas de participar.</p>
        <div class="flex flex-wrap gap-3">
          <a href={DISCORD_URL} target="_blank" rel="noopener noreferrer" class="rounded-lg bg-action px-5 py-3 font-bold text-on-action no-underline">Entrar no Discord</a>
          <a href="/participe/estudar" class="rounded-lg border border-link px-5 py-3 font-bold text-link no-underline">Ver #QueroEstudar</a>
        </div>
      </div>
    </section>
  </div>
</PublicLayout>
