---
// Formulário público de submissão de proposta — página gerada em build para
// cada campanha aberta do snapshot (mesmo pattern de /eventos/[...path]).
// A ilha valida o estado ao vivo (a campanha pode ter fechado desde o último
// sync) antes de habilitar o envio.
import PublicLayout from "../../../layouts/PublicLayout.astro";
import C4pSubmissionIsland from "../../../components/islands/c4p/C4pSubmissionIsland";
import { loadC4pIndex, type C4pSnapshotCall } from "../../../lib/c4p";

export function getStaticPaths() {
  return loadC4pIndex().calls.map((call) => ({
    params: { slug: call.slug },
    props: { call },
  }));
}

interface Props {
  call: C4pSnapshotCall;
}

const { call } = Astro.props;
---

<PublicLayout
  title={`Submeter proposta — ${call.name} | CODAQUI.dev`}
  ogTitle={`Submeter proposta — ${call.name}`}
  description={`Envie sua proposta de palestra para ${call.name}. Submissão pública com consentimento e verificação de segurança.`}
  noindex
>
  <div class="mx-auto max-w-3xl px-4 py-10">
    <C4pSubmissionIsland slug={call.slug} client:only="react" />
  </div>
</PublicLayout>
