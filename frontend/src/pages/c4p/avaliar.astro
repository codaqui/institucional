---
import PublicLayout from "../../layouts/PublicLayout.astro";
import C4pEvaluatorHomeIsland from "../../components/islands/c4p/C4pEvaluatorHomeIsland";
---

<PublicLayout
  title="Avaliar propostas (C4P) | CODAQUI.dev"
  ogTitle="Avaliação de propostas C4P"
  description="Aceite convites e avalie as propostas das chamadas de trabalhos em que você é avaliador(a)."
  noindex
>
  <main id="conteudo" class="mx-auto max-w-3xl px-4 py-10">
    <C4pEvaluatorHomeIsland client:only="react" />
    <noscript>
      <p class="rounded-lg border border-border bg-surface p-4 text-text-secondary">
        A área do avaliador requer JavaScript.
      </p>
    </noscript>
  </main>
</PublicLayout>
