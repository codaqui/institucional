---
// Portado de src/pages/projetos.tsx (Docusaurus + MUI → Astro + Tailwind).
import PublicLayout from "../layouts/PublicLayout.astro";
import PageHero from "../components/astro/PageHero.astro";
import {
  groupProjectsByCategory,
  loadProjectsIndex,
  projectHref,
  type ProjectCategory,
} from "../data/projects-extension";

const groups = groupProjectsByCategory(loadProjectsIndex().projects);

const CATEGORY_CONTENT: Record<ProjectCategory, { title: string; description: string; action: string }> = {
  program: {
    title: "Programas",
    description: "Programas contínuos que conectam pessoas, territórios e instituições.",
    action: "Conhecer programa",
  },
  extension: {
    title: "Projetos de extensão",
    description: "Iniciativas com entidades parceiras, mentoria e participação de voluntários.",
    action: "Ver projeto",
  },
  campaign: {
    title: "Campanhas",
    description: "Ações realizadas pelas comunidades, com resultados e prestação de contas publicados.",
    action: "Ler campanha",
  },
  open_source: {
    title: "Projetos open source",
    description: "Código aberto mantido pela rede Codaqui e aberto para contribuição.",
    action: "Ver no GitHub",
  },
};
---

<PublicLayout
  title="Projetos | CODAQUI.dev"
  ogTitle="Projetos | CODAQUI.dev"
  description="Programas, projetos de extensão, campanhas e código aberto das comunidades Codaqui."
>
  <PageHero
    eyebrow="Atuação das comunidades"
    title="Projetos da rede Codaqui"
    subtitle="Conheça as iniciativas realizadas pela Codaqui e pelas comunidades, escolha onde participar e acompanhe o que já foi realizado."
  />
  <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
    {groups.map((group) => {
      const content = CATEGORY_CONTENT[group.category];
      const headingId = `projetos-${group.category}`;
      return (
        <section class="mb-14" aria-labelledby={headingId}>
          <div class="mb-6">
            <h2 id={headingId} class="mb-2 text-2xl font-extrabold text-text-primary">{content.title}</h2>
            <p class="text-text-secondary">{content.description}</p>
          </div>

          {group.category === "open_source" && (
            <div class="mb-8 rounded-lg border border-border bg-sunken p-6">
              <h3 class="mb-3 text-xl font-bold">Como contribuir?</h3>
              <ol class="m-0 list-decimal ps-6">
                <li class="mb-1">Escolha um projeto que desperte seu interesse.</li>
                <li class="mb-1">Abra uma <em>issue</em> descrevendo o que gostaria de fazer.</li>
                <li>Aguarde o ok da equipe e mãos à obra!</li>
              </ol>
            </div>
          )}

          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 md:grid-cols-3">
            {group.projects.map((project) => {
              const href = projectHref(project);
              const external = href.startsWith("https://");
              return (
                <article class="flex h-full flex-col rounded-lg border border-border bg-surface p-4 transition-all duration-200 hover:-translate-y-0.5 hover:border-link hover:shadow-md">
                  <p class="mb-2 text-xs font-bold uppercase tracking-wide text-primary-700">{project.entity.name}</p>
                  <h3 class="mb-2 text-lg font-bold text-text-primary">{project.name}</h3>
                  <p class="mb-4 grow text-sm text-text-secondary">{project.summary}</p>
                  <a
                    href={href}
                    aria-label={`${content.action}: ${project.name}`}
                    {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
                    class="inline-flex w-fit items-center rounded-lg border border-link px-3 py-1 text-sm font-semibold text-link no-underline transition-colors hover:bg-link hover:text-white"
                  >
                    {content.action}
                  </a>
                </article>
              );
            })}
          </div>
        </section>
      );
    })}
  </div>
</PublicLayout>
