---
// Página "Mentores" da CamposTech dentro do portal Codaqui (rota
// `/comunidades/campostechpg/mentores`). Mesmo port 1:1 de
// comunidades/campostechpg/src/pages/mentores.tsx (spec). A CamposTech não é
// tenant — o config é importado direto de
// `comunidades/campostechpg/community.config` e o homeHref é o basePath da
// comunidade. Hero accent, seção "Mentores voluntários" com os cards a partir
// de `comunidades/campostechpg/src/data/team.ts` (fonte READ-ONLY, mesma
// importada pelo site Docusaurus até a 0.6) e ícones LinkedIn/Instagram.
import CommunityLayout from "../../../components/astro/community/CommunityLayout.astro";
import { communityBasePath } from "../../../lib/community";

import config from "../../../../../comunidades/campostechpg/community.config";
import { mentores } from "../../../../../comunidades/campostechpg/src/data/team";

const site = Astro.site?.toString() ?? "https://codaqui.dev";
const homeHref = communityBasePath(config);

// Ícones linkedin/instagram do @mui/icons-material (fill currentColor).
const LINKEDIN_PATH =
  "M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z";
const INSTAGRAM_PATH =
  "M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z";
---

<CommunityLayout
  config={config}
  site={site}
  title={`Mentores — ${config.shortName}`}
  description={`Conheça os mentores voluntários da ${config.name}`}
  homeHref={homeHref}
>
  <section class="cq-hero text-white">
    <div class="mx-auto max-w-6xl px-4 py-12 md:py-16">
      <div class="max-w-[760px] space-y-4">
        <span
          class="inline-block w-fit rounded-full bg-white/20 px-3 py-1.5 text-sm font-semibold"
        >
          {config.name}
        </span>
        <h1 class="m-0 text-3xl font-extrabold md:text-5xl">Nossos mentores</h1>
        <p class="m-0 text-xl font-normal opacity-95">
          Contamos com um espaço para que mentores voluntários ofereçam algumas
          horas de seu mês para compartilhar conhecimento com a comunidade. Quem
          tiver interesse em ser mentorado basta entrar em contato com os
          mentores.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10 md:py-16">
    <div class="mb-16">
      <h2 class="m-0 mb-2 text-3xl font-bold">Mentores voluntários</h2>
      <p class="m-0 mb-4 max-w-[700px] text-text-secondary">
        Profissionais de diversas áreas que dedicam tempo para mentorar a
        comunidade.
      </p>
      <hr class="mb-8 border-border" />
      <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3">
        {
          mentores.map((m) => (
            <div class="flex h-full flex-col rounded-lg border border-border bg-surface text-center transition duration-200 hover:-translate-y-0.5 hover:border-(--community-primary) hover:shadow-lg">
              <div class="flex flex-1 flex-col items-center gap-2 p-6">
                <img
                  src={m.avatar}
                  alt={`Foto de ${m.name}`}
                  width="80"
                  height="80"
                  class="h-20 w-20 rounded-full border-[3px] border-border object-cover"
                />
                <h3 class="m-0 text-xl font-bold">{m.name}</h3>
                <span class="mt-1 rounded-full border border-border px-2.5 py-0.5 text-xs font-semibold">
                  {m.role}
                </span>
                {m.specialty && (
                  <span
                    class="rounded-full px-2.5 py-0.5 text-xs font-semibold text-white"
                    style="background-color: var(--community-primary)"
                  >
                    {m.specialty}
                  </span>
                )}
              </div>
              <div class="flex justify-center gap-1 pb-4">
                {m.linkedin && (
                  <a
                    href={m.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`LinkedIn de ${m.name}`}
                    class="inline-flex h-8 w-8 items-center justify-center rounded-full no-underline transition-colors hover:bg-sunken"
                    style="color: var(--community-primary)"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                      class="h-5 w-5"
                    >
                      <path d={LINKEDIN_PATH} />
                    </svg>
                  </a>
                )}
                {m.instagram && (
                  <a
                    href={m.instagram}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`Instagram de ${m.name}`}
                    class="inline-flex h-8 w-8 items-center justify-center rounded-full text-text-primary no-underline transition-colors hover:bg-sunken"
                  >
                    <svg
                      viewBox="0 0 24 24"
                      fill="currentColor"
                      aria-hidden="true"
                      class="h-5 w-5"
                    >
                      <path d={INSTAGRAM_PATH} />
                    </svg>
                  </a>
                )}
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <style>
    .cq-hero {
      background-color: var(--community-primary);
    }
    :global([data-theme="dark"]) .cq-hero {
      background-color: var(--community-primary-dark);
    }
  </style>
</CommunityLayout>
