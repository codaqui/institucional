---
// Página "Apoiar" da Elas no Código dentro do portal Codaqui (rota
// `/comunidades/elasnocodigo/apoiar`). Mesmo port 1:1 de
// comunidades/elasnocodigo/src/pages/apoiar.tsx +
// comunidades/shared/components/CommunityApoiarPage.tsx (spec) da página do
// tenant em `frontend/src-tenants/elasnocodigo/pages/apoiar.astro` — mantidas
// em sync; só os imports e o homeHref diferem (aqui o homeHref é o
// communityBasePath do config).
// O original não passa infoCards — a seção de cards informativos não é emitida.
//
// ⚠️ Desvio conhecido vs. o original: o `CommunityLoginCTA` do Docusaurus não
// tem equivalente no app Astro (a própria ilha renderiza os prompts de auth),
// e o `authCommunitySlug` do DonationFlow original ainda não foi portado no
// app Astro (o startLogin não suporta communitySlug — ver docstring da ilha).
// Tudo que a ilha suporta hoje (lockedTargetId/hideWallets/accents/título) é
// passado 1:1.
import CommunityLayout from "../../../components/astro/community/CommunityLayout.astro";
import DonationFlowIsland from "../../../components/islands/DonationFlowIsland";
import { communityBasePath, loadTenantConfig } from "../../../lib/community";
import { getTenant, tenantSite } from "../../../lib/tenant";

const tenantBuild = getTenant() !== null;
const tenant = getTenant() ?? "elasnocodigo";
const config = await loadTenantConfig(tenant);
const site = Astro.site?.toString() ?? tenantSite(tenant);
const homeHref = tenantBuild ? "/" : communityBasePath(config);

// Ícone verified do @mui/icons-material (fill currentColor).
const VERIFIED_PATH =
  "M23 12l-2.44-2.79.34-3.69-3.61-.82-1.89-3.2L12 2.96 8.6 1.5 6.71 4.7 3.1 5.5l.34 3.7L1 12l2.44 2.79-.34 3.7 3.61.82L8.59 22.5 12 21.04l3.4 1.46 1.89-3.21 3.61-.82-.34-3.69L23 12zm-12.91 4.72l-3.8-3.81 1.48-1.48 2.32 2.33 5.85-5.87 1.48 1.48-7.33 7.35z";
---

<CommunityLayout
  config={config}
  site={site}
  title={`Apoiar — ${config.shortName}`}
  description={`Faça uma doação para a comunidade ${config.name}.`}
  homeHref={homeHref}
>
  <section class="cq-hero text-white">
    <div class="mx-auto max-w-6xl px-4 py-12 md:py-20">
      <div class="max-w-[760px] space-y-4">
        <span
          class="inline-block w-fit rounded-full bg-white/15 px-3 py-1.5 text-sm font-semibold"
        >
          Apoie esta comunidade
        </span>
        <h1 class="m-0 text-3xl font-extrabold md:text-5xl">
          💜 Apoie a {config.shortName}
        </h1>
        <p class="m-0 text-xl font-normal opacity-95">
          Sua contribuição fortalece encontros, lives e iniciativas que
          promovem a inclusão de mulheres na tecnologia.
        </p>
        <div class="flex items-center gap-1 pt-1 text-sm opacity-95">
          <svg
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
            class="h-4 w-4"
          >
            <path d={VERIFIED_PATH} />
          </svg>
          <p class="m-0">
            100% rastreado no Portal de Transparência da Associação Codaqui.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-3xl px-4 py-10 md:py-16">
    <div
      class="rounded-lg border bg-surface p-5 md:p-8"
      style="border-color: var(--community-primary)"
    >
      <DonationFlowIsland
        client:load
        lockedTargetId={config.slug}
        hideWallets
        accentColor={config.theme.primary}
        accentColorDark={config.theme.primaryDark}
        title={`Apoiar a ${config.shortName}`}
        subtitle={`Mensal, anual ou doação única. 100% direcionado para a ${config.shortName}.`}
      />
    </div>
  </section>

  <style>
    .cq-hero {
      background-color: var(--community-primary);
    }
    [data-theme="dark"] .cq-hero {
      background-color: var(--community-primary-dark);
    }
  </style>
</CommunityLayout>
