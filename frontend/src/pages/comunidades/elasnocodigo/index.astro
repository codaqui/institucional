---
// Home da Elas no Código no portal codaqui (/comunidades/elasnocodigo) —
// wrapper do HomePage com as rotas do portal.
import HomePage from "../../../components/astro/community/elasnocodigo/HomePage.astro";
import { communityBasePath, loadTenantConfig } from "../../../lib/community";
import { tenantSite } from "../../../lib/tenant";

const tenant = "elasnocodigo";
const config = await loadTenantConfig(tenant);
const site = Astro.site?.toString() ?? tenantSite(tenant);
const homeHref = communityBasePath(config);
---

<HomePage config={config} site={site} homeHref={homeHref} />
