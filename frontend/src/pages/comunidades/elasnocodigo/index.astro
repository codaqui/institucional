---
// Home da Elas no Código dentro do portal Codaqui (build codaqui, rota
// `/comunidades/elasnocodigo`). Mesmo port 1:1 de
// comunidades/elasnocodigo/src/pages/index.tsx (spec) das páginas do tenant
// em `frontend/src-tenants/elasnocodigo/pages/` — mantidas em sync; só os
// imports e o homeHref diferem (aqui `getTenant()` é null e o homeHref
// resolve para `communityBasePath(config)`).
import CommunityLayout from "../../../components/astro/community/CommunityLayout.astro";
import CommunityImpactSection from "../../../components/astro/community/CommunityImpactSection.astro";
import CommunityExploreSection from "../../../components/astro/community/CommunityExploreSection.astro";
import CommunityChannelsSection from "../../../components/astro/community/CommunityChannelsSection.astro";
import { communityBasePath, loadTenantConfig } from "../../../lib/community";
import type { CommunityExploreCard } from "../../../lib/community-sections";
import { getTenant, tenantSite } from "../../../lib/tenant";

const tenantBuild = getTenant() !== null;
const tenant = getTenant() ?? "elasnocodigo";
const config = await loadTenantConfig(tenant);
const site = Astro.site?.toString() ?? tenantSite(tenant);
const homeHref = tenantBuild ? "/" : communityBasePath(config);

// Rotas limpas no build tenant: remove o basePath do portal dos links
// derivados do config (cards de explore e CTA primário do hero).
const stripBase = (to: string) =>
  to.startsWith(config.basePath) ? to.slice(config.basePath.length) || "/" : to;

// Cards de "Explore a comunidade" — 1:1 com buildFeatureCards() do
// index.tsx (fonte é spec): mesma ordem (docs → donations → transparency),
// rótulos e descrições da Elas no Código.
const base = config.basePath;
const cards: CommunityExploreCard[] = [];
if (config.features.docs) {
  cards.push({
    icon: "menu_book",
    title: "Documentação",
    description: "Conheça nossas áreas de atuação e como participar.",
    to: `${base}/docs`,
  });
}
if (config.features.donations) {
  cards.push({
    icon: "volunteer_activism",
    title: "Apoiar",
    description: `Contribua com doações para a ${config.shortName}.`,
    to: `${base}/apoiar`,
  });
}
if (config.features.transparency) {
  cards.push({
    icon: "paid",
    title: "Transparência",
    description: `Veja saldo, entradas e saídas da conta da ${config.shortName} no ledger Codaqui.`,
    to: `${base}/transparencia`,
  });
}
const exploreCards = cards.map((card) => ({
  ...card,
  to: tenantBuild ? stripBase(card.to) : card.to,
}));

// "Nossas ações" — mesmos 3 cards do index.tsx (título, status e descrição).
// Ícones podcasts/menu_book/groups do @mui/icons-material (fill currentColor).
const actions = [
  {
    title: "Podcast Elas no Código",
    status: "Em breve",
    description: "Disponível no seu agregador de streamings.",
    iconPaths: [
      "M14 12c0 .74-.4 1.38-1 1.72V22h-2v-8.28c-.6-.35-1-.98-1-1.72 0-1.1.9-2 2-2s2 .9 2 2m-2-6c-3.31 0-6 2.69-6 6 0 1.74.75 3.31 1.94 4.4l1.42-1.42C8.53 14.25 8 13.19 8 12c0-2.21 1.79-4 4-4s4 1.79 4 4c0 1.19-.53 2.25-1.36 2.98l1.42 1.42C17.25 15.31 18 13.74 18 12c0-3.31-2.69-6-6-6m0-4C6.48 2 2 6.48 2 12c0 2.85 1.2 5.41 3.11 7.24l1.42-1.42C4.98 16.36 4 14.29 4 12c0-4.41 3.59-8 8-8s8 3.59 8 8c0 2.29-.98 4.36-2.53 5.82l1.42 1.42C20.8 17.41 22 14.85 22 12c0-5.52-4.48-10-10-10",
    ],
  },
  {
    title: "Cursos de JavaScript e Java",
    status: "Matrículas encerradas",
    description: "Estudo personalizado e direcionado às suas necessidades.",
    iconPaths: [
      "M21 5c-1.11-.35-2.33-.5-3.5-.5-1.95 0-4.05.4-5.5 1.5-1.45-1.1-3.55-1.5-5.5-1.5S2.45 4.9 1 6v14.65c0 .25.25.5.5.5.1 0 .15-.05.25-.05C3.1 20.45 5.05 20 6.5 20c1.95 0 4.05.4 5.5 1.5 1.35-.85 3.8-1.5 5.5-1.5 1.65 0 3.35.3 4.75 1.05.1.05.15.05.25.05.25 0 .5-.25.5-.5V6c-.6-.45-1.25-.75-2-1m0 13.5c-1.1-.35-2.3-.5-3.5-.5-1.7 0-4.15.65-5.5 1.5V8c1.35-.85 3.8-1.5 5.5-1.5 1.2 0 2.4.15 3.5.5z",
      "M17.5 10.5c.88 0 1.73.09 2.5.26V9.24c-.79-.15-1.64-.24-2.5-.24-1.7 0-3.24.29-4.5.83v1.66c1.13-.64 2.7-.99 4.5-.99M13 12.49v1.66c1.13-.64 2.7-.99 4.5-.99.88 0 1.73.09 2.5.26V11.9c-.79-.15-1.64-.24-2.5-.24-1.7 0-3.24.3-4.5.83m4.5 1.84c-1.7 0-3.24.29-4.5.83v1.66c1.13-.64 2.7-.99 4.5-.99.88 0 1.73.09 2.5.26v-1.52c-.79-.16-1.64-.24-2.5-.24",
    ],
  },
  {
    title: "Encontros e lives",
    status: "3 encontros",
    description: "Conteúdo gratuito e colaborativo, disponível no YouTube.",
    iconPaths: [
      "M12 12.75c1.63 0 3.07.39 4.24.9 1.08.48 1.76 1.56 1.76 2.73V18H6v-1.61c0-1.18.68-2.26 1.76-2.73 1.17-.52 2.61-.91 4.24-.91M4 13c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2m1.13 1.1c-.37-.06-.74-.1-1.13-.1-.99 0-1.93.21-2.78.58C.48 14.9 0 15.62 0 16.43V18h4.5v-1.61c0-.83.23-1.61.63-2.29M20 13c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2m4 3.43c0-.81-.48-1.53-1.22-1.85-.85-.37-1.79-.58-2.78-.58-.39 0-.76.04-1.13.1.4.68.63 1.46.63 2.29V18H24zM12 6c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3",
    ],
  },
];

// Ícones volunteer_activism/open_in_new do @mui/icons-material (hero CTAs).
const VOLUNTEER_ACTIVISM_PATH =
  "M1 11h4v11H1zm15-7.75C16.65 2.49 17.66 2 18.7 2 20.55 2 22 3.45 22 5.3c0 2.27-2.91 4.9-6 7.7-3.09-2.81-6-5.44-6-7.7C10 3.45 11.45 2 13.3 2c1.04 0 2.05.49 2.7 1.25M20 17h-7l-2.09-.73.33-.94L13 16h2.82c.65 0 1.18-.53 1.18-1.18 0-.49-.31-.93-.77-1.11L8.97 11H7v9.02L14 22l8.01-3c-.01-1.1-.9-2-2.01-2";
const OPEN_IN_NEW_PATH =
  "M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3z";

const ctaPrimaryHref = tenantBuild
  ? stripBase(config.hero.ctaPrimary.to)
  : config.hero.ctaPrimary.to;
---

<CommunityLayout
  config={config}
  site={site}
  title={`${config.shortName} — Comunidade parceira`}
  homeHref={homeHref}
>
  <section class="cq-hero text-white">
    <div class="mx-auto max-w-6xl px-4 py-12 md:py-20">
      <div class="grid items-center gap-8 md:grid-cols-[7fr_5fr]">
        <div class="space-y-6">
          <span
            class="inline-block w-fit rounded-full bg-white/15 px-3 py-1.5 text-sm font-semibold"
          >
            Comunidade parceira da Codaqui
          </span>
          <h1 class="m-0 text-3xl font-extrabold md:text-5xl">
            Olá, nós somos <span class="cq-highlight">{config.shortName}</span>
          </h1>
          <p class="m-0 text-xl font-normal opacity-95">
            Apoiamos e incentivamos <span class="cq-highlight font-bold"
              >mulheres</span
            > na tecnologia.
          </p>
          <p class="m-0 opacity-90">{config.description}</p>
          <div class="flex flex-col gap-4 pt-2 sm:flex-row">
            <a
              href={ctaPrimaryHref}
              class="cq-cta-primary inline-flex items-center justify-center gap-2 rounded-md px-5 py-2.5 text-sm font-bold no-underline"
            >
              <svg
                viewBox="0 0 24 24"
                fill="currentColor"
                aria-hidden="true"
                class="h-5 w-5"
              >
                <path d={VOLUNTEER_ACTIVISM_PATH}></path>
              </svg>
              {config.hero.ctaPrimary.label}
            </a>
            {
              config.hero.ctaSecondary && (
                <a
                  href={config.hero.ctaSecondary.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center justify-center gap-2 rounded-md border border-white/60 px-5 py-2.5 text-sm font-bold text-white no-underline transition-colors hover:border-white hover:bg-white/5"
                >
                  {config.hero.ctaSecondary.label}
                  <svg
                    viewBox="0 0 24 24"
                    fill="currentColor"
                    aria-hidden="true"
                    class="h-4 w-4"
                  >
                    <path d={OPEN_IN_NEW_PATH}></path>
                  </svg>
                </a>
              )
            }
          </div>
        </div>
        <div class="text-center">
          <div class="relative mx-auto w-45 md:w-65">
            <img
              src={config.logoUrl}
              alt={`Logo ${config.shortName}`}
              class="cq-logo-light block h-auto w-full"
            />
            {
              config.logoUrlDark && (
                <img
                  src={config.logoUrlDark}
                  alt={`Logo ${config.shortName}`}
                  class="cq-logo-dark absolute top-0 left-0 h-auto w-full"
                />
              )
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="acoes" class="mx-auto max-w-6xl px-4 py-10 md:py-16">
    <h2 class="m-0 mb-4 text-3xl font-bold">
      Nossas <span style="color: var(--community-primary)">ações</span>
    </h2>
    <p class="m-0 mb-8 text-text-secondary">
      Conheça nosso trabalho de inclusão de mulheres na tecnologia.
    </p>
    <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3">
      {
        actions.map((action) => (
          <div class="h-full rounded-lg border border-border bg-surface p-6 text-center">
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              class="mx-auto mb-4 h-8 w-8"
              style="color: var(--community-primary)"
            >
              {action.iconPaths.map((d) => (
                <path d={d} />
              ))}
            </svg>
            <h3 class="m-0 mb-2 text-xl font-bold">{action.title}</h3>
            <span class="cq-status-chip mb-3 inline-block rounded-full px-2.5 py-0.5 text-xs font-semibold">
              {action.status}
            </span>
            <p class="m-0 text-sm text-text-secondary">{action.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <CommunityImpactSection config={config} />
  <CommunityExploreSection config={config} cards={exploreCards} />
  <CommunityChannelsSection config={config} />

  <style>
    .cq-hero {
      background-color: var(--community-primary);
    }
    [data-theme="dark"] .cq-hero {
      background-color: var(--community-primary-dark);
    }
    /* Título/destaque do hero na cor de destaque do tema (accent). */
    .cq-highlight {
      color: var(--community-accent);
    }
    /* CTA primário do hero: fundo accent com texto primaryDark (1:1 do sx
       bgcolor: highlight / color: accentDark do original). */
    .cq-cta-primary {
      background-color: var(--community-accent);
      color: var(--community-primary-dark);
    }
    .cq-cta-primary:hover {
      background-color: #ffca28;
    }
    /* Chip de status dos cards de ações: bgcolor highlight, texto accentDark. */
    .cq-status-chip {
      background-color: var(--community-accent);
      color: var(--community-primary-dark);
    }
    /* Logo clara/escura conforme o tema (padrão community-logo-* do original). */
    .cq-logo-dark {
      display: none;
    }
    [data-theme="dark"] .cq-logo-light {
      display: none;
    }
    [data-theme="dark"] .cq-logo-dark {
      display: block;
    }
  </style>
</CommunityLayout>
