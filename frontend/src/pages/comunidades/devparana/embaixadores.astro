---
// Wrapper codaqui de "Embaixadores" do DevParaná
// (`/comunidades/devparana/embaixadores`) — espelho de
// src-tenants/devparana/pages/embaixadores.astro no build do portal.
// Port 1:1 de comunidades/devparana/src/pages/embaixadores.tsx (spec):
// responsabilidades + regiões do Paraná com embaixadores de
// `comunidades/devparana/src/data/ambassadors.ts` enriquecidos com a API
// pública em build time.
import CommunityLayout from "../../../components/astro/community/CommunityLayout.astro";
import { communityBasePath, loadTenantConfig } from "../../../lib/community";
import { tenantSite } from "../../../lib/tenant";
import { loadPublicMembers } from "../../../lib/member-pages";
import {
  ambassadorResponsibilities,
  findMemberByAmbassador,
} from "../../../lib/community-devparana";
import { regions } from "../../../../../comunidades/devparana/src/data/ambassadors";

const config = await loadTenantConfig("devparana");
const site = Astro.site?.toString() ?? tenantSite("devparana");
const homeHref = communityBasePath(config);

const apiMembers = await loadPublicMembers();

// Ícones check_circle/linkedin/github/email do @mui/icons-material (fill currentColor).
const CHECK_CIRCLE_PATH =
  "M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2m-2 15-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8z";
const LINKEDIN_PATH =
  "M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z";
const GITHUB_PATH =
  "M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6.1-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.3 2.8.1 3.2.8.8 1.3 1.9 1.3 3.2 0 4.6-2.9 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3";
const EMAIL_PATH =
  "M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z";
---

<CommunityLayout
  config={config}
  site={site}
  title={`Embaixadores — ${config.shortName}`}
  description="Conheça as regiões do Paraná e os embaixadores do DevParaná."
  homeHref={homeHref}
>
  <section class="cq-hero text-white">
    <div class="mx-auto max-w-6xl px-4 py-12 md:py-20">
      <div class="max-w-[760px] space-y-4">
        <span
          class="inline-block w-fit rounded-full bg-white/15 px-3 py-1.5 text-sm font-semibold"
        >
          {config.name}
        </span>
        <h1 class="m-0 text-3xl font-extrabold md:text-5xl">Embaixadores</h1>
        <p class="m-0 text-xl font-normal opacity-95">
          O Projeto Embaixadores organiza o DevParaná em regiões do estado,
          garantindo que cada cidade tenha uma pessoa de referência.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10 md:py-16">
    <h2 class="m-0 mb-2 text-3xl font-bold">Responsabilidades</h2>
    <p class="m-0 mb-4 max-w-[700px] text-text-secondary">
      Os embaixadores são referências regionais que representam a comunidade,
      fomentam novos grupos e apoiam eventos locais.
    </p>
    <div class="mb-8 grid gap-3 md:grid-cols-2">
      {
        ambassadorResponsibilities.map((text) => (
          <div class="flex items-start gap-2.5">
            <svg
              viewBox="0 0 24 24"
              fill="currentColor"
              aria-hidden="true"
              class="mt-0.5 h-5 w-5 shrink-0"
              style="color: var(--community-primary)"
            >
              <path d={CHECK_CIRCLE_PATH}></path>
            </svg>
            <p class="m-0">{text}</p>
          </div>
        ))
      }
    </div>

    <h2 class="m-0 mb-2 text-3xl font-bold">Regiões do Paraná</h2>
    <p class="m-0 mb-6 text-text-secondary">
      O estado está dividido em {regions.length} regiões. Em breve todas terão
      embaixadores confirmados.
    </p>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        regions.map((region) => {
          const ambassador = region.ambassador;
          const member = ambassador
            ? findMemberByAmbassador(ambassador, apiMembers)
            : undefined;
          const name = member?.name ?? ambassador?.name ?? "";
          const avatar = member?.avatarUrl ?? ambassador?.avatar;
          const linkedin = member?.linkedinUrl ?? ambassador?.linkedin;
          const github = member?.githubHandle
            ? `https://github.com/${member.githubHandle}`
            : ambassador?.github;
          const bio = member?.bio ?? ambassador?.bio;
          return (
            <div class="h-full rounded-lg border border-border bg-surface transition duration-200 hover:-translate-y-0.5 hover:border-(--community-primary) hover:shadow-lg">
              <div class="p-6">
                <h3
                  class="m-0 mb-3 text-2xl font-bold"
                  style="color: var(--community-primary)"
                >
                  {region.name}
                </h3>

                {ambassador ? (
                  <div class="mb-4 flex items-center gap-3">
                    {avatar && (
                      <img
                        src={avatar}
                        alt={name}
                        width="64"
                        height="64"
                        loading="lazy"
                        class="h-16 w-16 shrink-0 rounded-full border-[3px] border-border object-cover"
                      />
                    )}
                    <div>
                      <p class="m-0 font-bold">{name}</p>
                      <p class="m-0 text-sm text-text-secondary">
                        {ambassador.role}
                      </p>
                      {bio && (
                        <p class="m-0 mt-0.5 block text-xs text-text-secondary">
                          {bio}
                        </p>
                      )}
                      <div class="mt-1 flex gap-1">
                        {ambassador.email && (
                          <a
                            href={`mailto:${ambassador.email}`}
                            aria-label={`E-mail de ${name}`}
                            class="inline-flex h-7 w-7 items-center justify-center no-underline"
                            style="color: var(--community-primary)"
                          >
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-4 w-4">
                              <path d={EMAIL_PATH}></path>
                            </svg>
                          </a>
                        )}
                        {linkedin && (
                          <a
                            href={linkedin}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`LinkedIn de ${name}`}
                            class="inline-flex h-7 w-7 items-center justify-center no-underline"
                            style="color: var(--community-primary)"
                          >
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-4 w-4">
                              <path d={LINKEDIN_PATH}></path>
                            </svg>
                          </a>
                        )}
                        {github && (
                          <a
                            href={github}
                            target="_blank"
                            rel="noopener noreferrer"
                            aria-label={`GitHub de ${name}`}
                            class="inline-flex h-7 w-7 items-center justify-center no-underline"
                            style="color: var(--community-primary)"
                          >
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-4 w-4">
                              <path d={GITHUB_PATH}></path>
                            </svg>
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                ) : (
                  <div class="mb-4 rounded-lg border border-border bg-sunken p-3 text-sm text-text-secondary">
                    Vaga aberta — entre em contato caso queira representar esta
                    região.
                  </div>
                )}

                <p class="m-0 mb-1 text-sm font-bold">Cidades</p>
                <div class="flex flex-wrap gap-1.5">
                  {region.cities.map((city) => (
                    <span class="rounded-full border border-border px-2.5 py-0.5 text-xs font-semibold text-text-secondary">
                      {city}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          );
        })
      }
    </div>
  </section>

  <style>
    .cq-hero {
      background-color: var(--community-primary);
    }
    [data-theme="dark"] .cq-hero {
      background-color: var(--community-primary-dark);
    }
  </style>
</CommunityLayout>
