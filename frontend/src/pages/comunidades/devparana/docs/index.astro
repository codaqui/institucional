---
// Índice da documentação do DevParaná no portal codaqui:
// /comunidades/devparana/docs. Renderiza `docs/index.md` (canônico em
// comunidades/devparana/docs/, READ-ONLY) — ver docstring de
// DevparanaDocsRoute.astro. Os RFCs ficam em `./[...slug].astro`.
import DevparanaDocsRoute from "../../../../components/astro/community/devparana/DevparanaDocsRoute.astro";
import { communityBasePath, loadTenantConfig } from "../../../../lib/community";
import { tenantSite } from "../../../../lib/tenant";

const config = await loadTenantConfig("devparana");
const site = Astro.site?.toString() ?? tenantSite("devparana");
const homeHref = communityBasePath(config);
---

<DevparanaDocsRoute slug="index" config={config} site={site} homeHref={homeHref} />
