---
// Posts por etiqueta (build tenant, /blog/tags/<tag>, página 1).
// Port de /comunidades/tisocial/blog/tags/<tag>.
import { getCollection } from "astro:content";
import CommunityBlogTagPostsPage from "../../../components/astro/community/CommunityBlogTagPostsPage.astro";
import { communityBasePath, loadTenantConfig } from "../../../lib/community";
import {
  COMMUNITY_POSTS_PER_PAGE,
  COMMUNITY_SIDEBAR_COUNT,
  communityPostUrl,
  communityTagUrl,
  collectCommunityPostsByTag,
  groupCommunityPostsByYear,
  publishedCommunityPosts,
  sortCommunityPosts,
} from "../../../lib/community-blog";
import { getTenant, tenantSite } from "../../../lib/tenant";

export async function getStaticPaths() {
  const all = sortCommunityPosts(
    publishedCommunityPosts(await getCollection("communityBlog")),
  );
  return [...collectCommunityPostsByTag(all).entries()].map(([slug, group]) => ({
    params: { tag: slug },
    props: { tagLabel: group.label },
  }));
}

const tenantBuild = getTenant() !== null;
const tenant = getTenant() ?? "tisocial";
const config = await loadTenantConfig(tenant);
const site = Astro.site?.toString() ?? tenantSite(tenant);
const homeHref = tenantBuild ? "/" : communityBasePath(config);
const basePath = tenantBuild ? "/blog" : `${communityBasePath(config)}/blog`;

const tagSlug = Astro.params.tag!;
const all = sortCommunityPosts(
  publishedCommunityPosts(await getCollection("communityBlog")),
);
const group = collectCommunityPostsByTag(all).get(tagSlug)!;
const totalCount = group.posts.length;
const totalPages = Math.ceil(totalCount / COMMUNITY_POSTS_PER_PAGE);
const yearGroups = groupCommunityPostsByYear(
  all.slice(0, COMMUNITY_SIDEBAR_COUNT),
).map((g) => ({
  year: g.year,
  posts: g.posts.map((post) => ({
    url: communityPostUrl(post, basePath),
    title: post.data.title,
  })),
}));
---

<CommunityBlogTagPostsPage
  config={config}
  site={site}
  homeHref={homeHref}
  basePath={basePath}
  tagBasePath={communityTagUrl(group.label, basePath)}
  tagLabel={group.label}
  totalCount={totalCount}
  page={1}
  totalPages={totalPages}
  posts={group.posts.slice(0, COMMUNITY_POSTS_PER_PAGE)}
  yearGroups={yearGroups}
/>
