---
// Índice de etiquetas do blog da T.I. Social (build tenant, /blog/tags).
// Port de /comunidades/tisocial/blog/tags ("Etiquetas", grupos por letra).
import { getCollection } from "astro:content";
import CommunityBlogTagsIndexPage from "../../../components/astro/community/CommunityBlogTagsIndexPage.astro";
import { communityBasePath, loadTenantConfig } from "../../../lib/community";
import {
  COMMUNITY_SIDEBAR_COUNT,
  communityPostUrl,
  communityTagUrl,
  collectCommunityPostsByTag,
  groupCommunityPostsByYear,
  publishedCommunityPosts,
  sortCommunityPosts,
} from "../../../lib/community-blog";
import { getTenant, tenantSite } from "../../../lib/tenant";

const tenantBuild = getTenant() !== null;
const tenant = getTenant() ?? "tisocial";
const config = await loadTenantConfig(tenant);
const site = Astro.site?.toString() ?? tenantSite(tenant);
const homeHref = tenantBuild ? "/" : communityBasePath(config);
const basePath = tenantBuild ? "/blog" : `${communityBasePath(config)}/blog`;

const all = sortCommunityPosts(
  publishedCommunityPosts(await getCollection("communityBlog")),
);
const byTag = collectCommunityPostsByTag(all);
const sortedTags = [...byTag.entries()].sort(([a], [b]) => a.localeCompare(b));
const letterGroups = sortedTags.reduce<
  { letter: string; tags: { label: string; url: string; count: number }[] }[]
>((groups, [slug, group]) => {
  const letter = slug[0].toUpperCase();
  const last = groups[groups.length - 1];
  const entry = {
    label: group.label,
    url: communityTagUrl(group.label, basePath),
    count: group.posts.length,
  };
  if (last && last.letter === letter) last.tags.push(entry);
  else groups.push({ letter, tags: [entry] });
  return groups;
}, []);
const yearGroups = groupCommunityPostsByYear(
  all.slice(0, COMMUNITY_SIDEBAR_COUNT),
).map((group) => ({
  year: group.year,
  posts: group.posts.map((post) => ({
    url: communityPostUrl(post, basePath),
    title: post.data.title,
  })),
}));
---

<CommunityBlogTagsIndexPage
  config={config}
  site={site}
  homeHref={homeHref}
  title="Etiquetas"
  yearGroups={yearGroups}
  letterGroups={letterGroups}
/>
