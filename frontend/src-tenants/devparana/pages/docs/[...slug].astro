---
// RFCs completos do site whitelabel DevParaná (build tenant):
// /docs/rfcs/<slug>. O frontmatter vem do MDX canônico em
// `comunidades/devparana/docs/rfcs/` (READ-ONLY) — ver docstring de
// DevparanaDocsRoute.astro. O índice da documentação é o `./index.astro`.
import DevparanaDocsRoute from "../../components/astro/community/devparana/DevparanaDocsRoute.astro";
import { communityBasePath, loadTenantConfig } from "../../lib/community";
import { getTenant, tenantSite } from "../../lib/tenant";
import { loadDevparanaRfcDocs } from "../../lib/community-devparana-docs";

export async function getStaticPaths() {
  return loadDevparanaRfcDocs().map((doc) => ({ params: { slug: doc.slug } }));
}

const { slug } = Astro.params;
const tenantBuild = getTenant() !== null;
const tenant = getTenant() ?? "devparana";
const config = await loadTenantConfig(tenant);
const site = Astro.site?.toString() ?? tenantSite(tenant);
const homeHref = tenantBuild ? "/" : communityBasePath(config);
---

<DevparanaDocsRoute slug={slug} config={config} site={site} homeHref={homeHref} />
