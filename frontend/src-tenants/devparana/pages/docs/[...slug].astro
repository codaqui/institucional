---
// RFCs completos do site whitelabel DevParaná (build tenant): rota limpa
// /docs/rfcs/<slug>. O corpo da página vive em DocsPage (compartilhado com o
// wrapper do portal codaqui). O índice da documentação é o `./index.astro`.
import DocsPage from "../../components/astro/community/devparana/DocsPage.astro";
import { communityBasePath, loadTenantConfig } from "../../lib/community";
import { getTenant, tenantSite } from "../../lib/tenant";
import { loadDevparanaRfcDocs } from "../../lib/community-devparana-docs";

export async function getStaticPaths() {
  return loadDevparanaRfcDocs().map((doc) => ({ params: { slug: doc.slug } }));
}

const { slug } = Astro.params;
const tenantBuild = getTenant() !== null;
const tenant = getTenant() ?? "devparana";
const config = await loadTenantConfig(tenant);
const site = Astro.site?.toString() ?? tenantSite(tenant);
const homeHref = tenantBuild ? "/" : communityBasePath(config);
---

<DocsPage slug={slug} config={config} site={site} homeHref={homeHref} />
