---
// Página "Equipe" do site whitelabel DevParaná (build tenant).
// Port 1:1 de comunidades/devparana/src/pages/equipe.tsx (spec): hero accent,
// seção "Coordenação e Voluntários" com cards a partir de
// `comunidades/devparana/src/data/team.ts` enriquecidos com a API pública.
//
// O original faz o enriquecimento com fetch client-side e exibe os dados
// locais enquanto carrega / em erro; aqui o enriquecimento é em build time
// (`loadPublicMembers` — sem API, cai nos dados locais com warn, mesmo
// comportamento do estado de erro do original).
import CommunityLayout from "../components/astro/community/CommunityLayout.astro";
import { communityBasePath, loadTenantConfig } from "../lib/community";
import { getTenant, tenantSite } from "../lib/tenant";
import { loadPublicMembers } from "../lib/member-pages";
import {
  enrichDevparanaTeamMember,
} from "../lib/community-devparana";
import { team } from "../../../../comunidades/devparana/src/data/team";

const tenantBuild = getTenant() !== null;
const tenant = getTenant() ?? "devparana";
const config = await loadTenantConfig(tenant);
const site = Astro.site?.toString() ?? tenantSite(tenant);
const homeHref = tenantBuild ? "/" : communityBasePath(config);

const apiMembers = await loadPublicMembers();
const enriched = team.map((member) => enrichDevparanaTeamMember(member, apiMembers));

// Ícones linkedin/github/email/open_in_new do @mui/icons-material (fill currentColor).
const LINKEDIN_PATH =
  "M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.32 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.79M6.88 8.56a1.68 1.68 0 0 0 1.68-1.68c0-.93-.75-1.69-1.68-1.69a1.69 1.69 0 0 0-1.69 1.69c0 .93.76 1.68 1.69 1.68m1.39 9.94v-8.37H5.5v8.37h2.77z";
const GITHUB_PATH =
  "M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6.1-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.3 2.8.1 3.2.8.8 1.3 1.9 1.3 3.2 0 4.6-2.9 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3";
const EMAIL_PATH =
  "M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4-8 5-8-5V6l8 5 8-5v2z";
const OPEN_IN_NEW_PATH =
  "M19 19H5V5h7V3H5c-1.11 0-2 .9-2 2v14c0 1.1.89 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zM14 3v2h3.59l-9.83 9.83 1.41 1.41L19 6.41V10h2V3z";
---

<CommunityLayout
  config={config}
  site={site}
  title={`Equipe — ${config.shortName}`}
  description={`Conheça as pessoas por trás do ${config.name}`}
  homeHref={homeHref}
>
  <section class="cq-hero text-white">
    <div class="mx-auto max-w-6xl px-4 py-12 md:py-20">
      <div class="max-w-[760px] space-y-4">
        <span
          class="inline-block w-fit rounded-full bg-white/15 px-3 py-1.5 text-sm font-semibold"
        >
          {config.name}
        </span>
        <h1 class="m-0 text-3xl font-extrabold md:text-5xl">Equipe</h1>
        <p class="m-0 text-xl font-normal opacity-95">
          O DevParaná é movido por voluntários que acreditam no poder da
          comunidade para transformar a carreira de pessoas desenvolvedoras.
        </p>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-10 md:py-16">
    <h2 class="m-0 mb-2 text-3xl font-bold">Coordenação e Voluntários</h2>
    <p class="m-0 mb-4 max-w-[700px] text-text-secondary">
      Conheça quem ajuda a manter a comunidade ativa em todo o Paraná.
    </p>
    <hr class="mb-8 border-border" />

    <div class="grid gap-6 sm:grid-cols-2 md:grid-cols-3">
      {
        enriched.map((member) =>
          member.isVolunteerCTA ? (
            <div class="cq-volunteer-card flex h-full flex-col rounded-lg border border-dashed bg-surface text-center transition duration-200 hover:-translate-y-0.5 hover:shadow-lg">
              <div class="flex flex-1 flex-col items-center gap-2 p-6">
                <img
                  src={member.avatar}
                  alt="Você?"
                  width="80"
                  height="80"
                  loading="lazy"
                  class="h-20 w-20 rounded-full border-[3px] border-border object-cover"
                />
                <h3 class="m-0 text-xl font-bold">{member.name}</h3>
                <span class="cq-chip-outline mt-1 rounded-full border px-2.5 py-0.5 text-xs font-semibold">
                  {member.role}
                </span>
                {member.specialty && (
                  <span class="cq-chip-accent rounded-full px-2.5 py-0.5 text-xs font-semibold">
                    {member.specialty}
                  </span>
                )}
                <p class="m-0 text-sm text-text-secondary">
                  Quer fazer parte da organização do DevParaná? Entre em contato
                  e ajude a levar a comunidade para mais cidades.
                </p>
              </div>
              <div class="flex flex-col justify-center gap-2 px-4 pt-0 pb-4 sm:flex-row">
                <a
                  href="mailto:contato@codaqui.dev"
                  class="cq-chip-outline inline-flex items-center justify-center gap-1.5 rounded-md border px-3 py-1.5 text-sm font-semibold no-underline"
                >
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-4 w-4">
                    <path d={EMAIL_PATH}></path>
                  </svg>
                  Fale com a gente
                </a>
                <a
                  href="https://www.meetup.com/pt-BR/developerparana/"
                  target="_blank"
                  rel="noopener noreferrer"
                  class="cq-btn-primary inline-flex items-center justify-center gap-1 rounded-md px-3 py-1.5 text-sm font-semibold no-underline"
                >
                  Conheça o Meetup
                  <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-3.5 w-3.5">
                    <path d={OPEN_IN_NEW_PATH}></path>
                  </svg>
                </a>
              </div>
            </div>
          ) : (
            <div class="flex h-full flex-col rounded-lg border border-border bg-surface text-center transition duration-200 hover:-translate-y-0.5 hover:border-(--community-primary) hover:shadow-lg">
              <div class="flex flex-1 flex-col items-center gap-2 p-6">
                <img
                  src={member.avatar}
                  alt={`Foto de ${member.name}`}
                  width="80"
                  height="80"
                  loading="lazy"
                  class="h-20 w-20 rounded-full border-[3px] border-border object-cover"
                />
                <h3 class="m-0 text-xl font-bold">{member.name}</h3>
                <div class="flex flex-wrap justify-center gap-1">
                  <span class="rounded-full border border-border px-2.5 py-0.5 text-xs font-semibold">
                    {member.role}
                  </span>
                  {member.specialty && (
                    <span class="cq-chip-accent rounded-full px-2.5 py-0.5 text-xs font-semibold">
                      {member.specialty}
                    </span>
                  )}
                </div>
                {member.bio && (
                  <p class="m-0 mt-1 text-sm text-text-secondary">
                    {member.bio}
                  </p>
                )}
              </div>
              <div class="flex justify-center gap-1 pb-4">
                {member.linkedin && (
                  <a
                    href={member.linkedin}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`LinkedIn de ${member.name}`}
                    class="inline-flex h-8 w-8 items-center justify-center rounded-full no-underline transition-colors hover:bg-sunken"
                    style="color: var(--community-primary)"
                  >
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-5 w-5">
                      <path d={LINKEDIN_PATH}></path>
                    </svg>
                  </a>
                )}
                {member.github && (
                  <a
                    href={member.github}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`GitHub de ${member.name}`}
                    class="inline-flex h-8 w-8 items-center justify-center rounded-full text-text-primary no-underline transition-colors hover:bg-sunken"
                  >
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-5 w-5">
                      <path d={GITHUB_PATH}></path>
                    </svg>
                  </a>
                )}
              </div>
            </div>
          ),
        )
      }
    </div>
  </section>

  <style>
    .cq-hero {
      background-color: var(--community-primary);
    }
    [data-theme="dark"] .cq-hero {
      background-color: var(--community-primary-dark);
    }
    .cq-chip-accent {
      background-color: color-mix(in srgb, var(--community-primary) 13%, transparent);
      color: var(--community-primary);
    }
    .cq-chip-outline {
      border-color: var(--community-primary);
      color: var(--community-primary);
    }
    .cq-btn-primary {
      background-color: var(--community-primary);
      color: #fff;
    }
    .cq-btn-primary:hover {
      background-color: var(--community-primary-light);
    }
    .cq-volunteer-card {
      border-color: var(--community-primary);
    }
  </style>
</CommunityLayout>
