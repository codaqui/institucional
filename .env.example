# ─────────────────────────────────────────────────────
# Discord — Sync de eventos e contagem de membros
# Token do bot Discord com intent GUILD_SCHEDULED_EVENTS
# Sem ele, os scripts de sync preservam os snapshots existentes
# ─────────────────────────────────────────────────────
DISCORD_BOT_TOKEN=COLE_SEU_TOKEN_AQUI

# ─────────────────────────────────────────────────────
# Banco de Dados (PostgreSQL)
# ─────────────────────────────────────────────────────
# Gere senhas seguras com: openssl rand -hex 16
DB_USER=codaqui
DB_PASSWORD=
DB_NAME=codaqui_db

# ─────────────────────────────────────────────────────
# GitHub OAuth — Autenticação
# Crie em: https://github.com/settings/developers → OAuth Apps
# DEV  callback: http://localhost:3001/auth/github/callback
# PROD callback: https://api.codaqui.dev/auth/github/callback
# (criar um OAuth App por ambiente)
# ─────────────────────────────────────────────────────
GITHUB_CLIENT_ID=COLE_AQUI
GITHUB_CLIENT_SECRET=COLE_AQUI

# ─────────────────────────────────────────────────────
# JWT — Segredo para assinar tokens internos
# Gere com: OpenSSL rand -hex 64
# ─────────────────────────────────────────────────────
JWT_SECRET=COLE_UM_SEGREDO_LONGO_AQUI

# ─────────────────────────────────────────────────────
# URLs dos serviços
# BACKEND_URL: URL pública do backend (usada no callback do GitHub OAuth)
# FRONTEND_URL: URL do frontend (usada nos redirects pós-autenticação/doação)
# ─────────────────────────────────────────────────────
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000

# ─────────────────────────────────────────────────────
# Stripe — Pagamentos
# Obtenha chaves em: https://dashboard.stripe.com/test/apikeys
# ─────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_COLE_SUA_CHAVE_AQUI
STRIPE_WEBHOOK_SECRET=whsec_COLE_SEU_SEGREDO_AQUI
STRIPE_PUBLISHABLE_KEY=pk_COLE_SUA_CHAVE
# Opcional: ID da Payment Method Configuration (habilita Apple Pay / Google Pay específicos)
# Obtenha em: https://dashboard.stripe.com/settings/payment_methods
STRIPE_PMC_ID=

# ─────────────────────────────────────────────────────
# Produção (compose.prod.yaml) — descomente e ajuste
# ─────────────────────────────────────────────────────
# BACKEND_URL=https://api.codaqui.dev
# FRONTEND_URL=https://codaqui.dev

# ─────────────────────────────────────────────────────
# GitHub-as-Database (overrides de eventos, organizers.json)
# O backend escreve no repositório com o token OAuth do PRÓPRIO MEMBRO
# logado (scope public_repo — o consentimento novo aparece no próximo
# login de cada usuário). Commits/PRs saem em nome do membro (contributor).
# Leituras são públicas (raw.githubusercontent.com), sem token.
# ─────────────────────────────────────────────────────
GITHUB_REPO_OWNER=codaqui
GITHUB_REPO_NAME=institucional
# Branch base de leitura/escrita do GitHub-as-Database (default: main).
# Em dev os PRs/merges vão para develop — sem isso o backend não enxerga
# os overrides/snapshots locais.
# GITHUB_BASE_BRANCH=develop
# Chave de 32 bytes (hex de 64 chars ou base64) para criptografar em
# repouso os tokens OAuth dos membros (AES-256-GCM — coluna
# members.githubAccessToken). OBRIGATÓRIA em produção. Em dev pode ficar
# vazia: os tokens são gravados com prefixo `plain:` (sem criptografia).
# Gere uma com: openssl rand -hex 32
# GITHUB_TOKEN_ENCRYPTION_KEY=
# GITHUB_BASE_BRANCH=develop
# ─────────────────────────────────────────────────────
# SMTP (e-mails de eventos — confirmação, lembrete D-1, pós-evento)
# Sem essas variáveis o backend NÃO quebra: os envios falham com
# SMTP_NOT_CONFIGURED e ficam registrados em email_logs para reenvio
# (POST /notifications/emails/:id/resend).
# Gmail: use uma "senha de app" (Conta Google → Segurança → Verificação
# em duas etapas → Senhas de app), NÃO a senha da conta.
# ─────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Remetente (default: SMTP_USER). Ex.: "Codaqui <contato@codaqui.dev>"
EMAIL_FROM=
